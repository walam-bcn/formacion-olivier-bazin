        {
          "@type": "Question",
          "name": "Què és la medicina integrativa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És un enfocament que combina la medicina convencional amb teràpies i hàbits de vida que compten amb suport científic, i que posa la persona al centre. A WA LAM no substituïm el teu metge: complementem el seu seguiment."
          }
        },
        {
          "@type": "Question",
          "name": "No sé quin tractament necessito. Per on començo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Comença pel motiu de consulta que més s'assembla al que et passa, o escriu-nos per WhatsApp. T'orientarem cap al professional adequat abans de reservar."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La primera visita costa 90 €. Les sessions d'osteopatia, massatge, reflexologia i drenatge limfàtic duren una hora i costen 70 €; la sessió d'acupuntura dura una hora i costa 50 €."
          }
        }
