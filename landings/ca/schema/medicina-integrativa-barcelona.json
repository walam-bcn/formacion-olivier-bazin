      "mainEntity": [
        {
          "@type": "Question",
          "name": "És el mateix que la medicina alternativa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La medicina alternativa es planteja com a substituta de la medicina convencional. La medicina integrativa la complementa i només utilitza les teràpies que disposen de suport científic."
          }
        },
        {
          "@type": "Question",
          "name": "Quant dura i quant costa la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dura seixanta minuts i costa 90 €."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito un diagnòstic per venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Pot venir amb un diagnòstic o simplement perquè nota que alguna cosa no va bé. A la primera visita revisem la seva història i les proves que ja tingui i, si cal alguna més, li ho indiquem."
          }
        }
      ]
