    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/reiki-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Què se sent durant una sessió de reiki?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La majoria de les persones descriuen una relaxació profunda, una sensació de calor o de pesantor agradable i, sovint, somnolència. Cada persona ho viu d'una manera diferent."
          }
        },
        {
          "@type": "Question",
          "name": "M'he de despullar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El reiki es rep vestit, amb roba còmoda. Només se li demanarà que es tregui les sabates."
          }
        },
        {
          "@type": "Question",
          "name": "En què es diferencia d'un massatge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el reiki no es pressiona ni es manipulen els músculs: les mans es recolzen amb suavitat o es mantenen a prop del cos. Per això és adequat quan el massatge no és possible o resulta molest."
          }
        },
        {
          "@type": "Question",
          "name": "Puc rebre reiki si estic en tractament oncològic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, amb l'autorització del seu oncòleg. És una tècnica molt suau que ofereixen programes d'oncologia integrativa de diferents hospitals per alleujar l'ansietat i el malestar durant el tractament."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Moltes persones noten una relaxació clara des de la primera sessió. Per a l'estrès, l'ansietat o l'insomni se sol recomanar una sessió setmanal durant algunes setmanes. L'orientem segons el seu cas."
          }
        }
      ]
    }
