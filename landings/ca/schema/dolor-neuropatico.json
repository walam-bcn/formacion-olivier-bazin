    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-neuropatic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quines disciplines intervenen en l'abordatge del dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'osteopatia i l'acupuntura, integrades en un pla individual. Quan cal un programa de fisioteràpia, fem la derivació a un fisioterapeuta col·legiat."
          }
        },
        {
          "@type": "Question",
          "name": "Substitueix el meu tractament mèdic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'acompanyament és complementari i no modifica la medicació prescrita."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu la ciàtica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, com a complement del seguiment mèdic, amb mobilitat, exercici adaptat i tècniques manuals quan estan indicades."
          }
        },
        {
          "@type": "Question",
          "name": "I la síndrome de dolor regional complex?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Només com a acompanyament complementari i sempre en paral·lel al seguiment per part de la unitat del dolor."
          }
        }
      ]
    }
