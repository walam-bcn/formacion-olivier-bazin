    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-neuropatic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "En què es diferencia el dolor neuropàtic d'altres dolors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el fet que no es deu a una lesió de músculs, articulacions o altres teixits, sinó dels mateixos nervis. Per això es percep d'una altra manera (cremor, descàrregues, formigueig) i respon pitjor als analgèsics habituals."
          }
        },
        {
          "@type": "Question",
          "name": "La ciàtica és un dolor neuropàtic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, quan hi ha irritació o compressió d'una arrel nerviosa. El dolor baixa per la cama, sovint per sota del genoll, i pot anar acompanyat de formigueig o adormiment al peu. Trobarà més informació a ciàtica."
          }
        },
        {
          "@type": "Question",
          "name": "Per què el dolor empitjora a la nit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Durant la nit hi ha menys estímuls que distreguin l'atenció i el sistema nerviós percep més els senyals de dolor. A més, el mal descans augmenta la sensibilitat l'endemà; per això tenim tanta cura del son."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els seus informes mèdics, les proves realitzades (electromiograma, ressonància o analítiques) i la llista de la medicació que pren."
          }
        }
      ]
    }
