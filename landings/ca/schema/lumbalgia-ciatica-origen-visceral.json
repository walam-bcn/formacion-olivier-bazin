    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/lumbalgia-ciatica-origen-visceral#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Com sé si la meva lumbàlgia ve de la pelvis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Algunes pistes: el dolor segueix el cicle, empitjora abans de la regla, s'acompanya de pesantor al baix ventre o de símptomes urinaris o digestius, i l'esquena es mou bé malgrat el dolor. La valoració ho confirma o ho descarta."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em fa mal l'esquena abans de la regla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A la fase premenstrual la pelvis es congestiona, l'úter pesa més i tracciona dels seus lligaments cap al sacre i la zona lumbar. Les fixacions dels ovaris també donen lumbàlgies baixes que augmenten en aquesta fase."
          }
        },
        {
          "@type": "Question",
          "name": "El mal d'esquena de l'embaràs és sempre de la columna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Segons els autors, la lumbàlgia de l'embarassada té més sovint un origen vascular (compressió de la vena cava i congestió venosa) que articular, a més de la compressió del ronyó per l'úter."
          }
        },
        {
          "@type": "Question",
          "name": "S'ha de manipular la columna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No necessàriament. Els autors aconsellen no tractar d'entrada la columna si no hi ha bloquejos clars: les restriccions solen ser adaptacions a la disfunció pelviana, i primer es treballen les vísceres."
          }
        },
        {
          "@type": "Question",
          "name": "Un ronyó pot donar mal d'esquena sense tenir càlculs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segons el llibre, sí: un ronyó fixat o descendit s'associa a dolor lumbar alt i pot alterar el drenatge venós de l'ovari esquerre. Els càlculs, en canvi, els ha de valorar el seu metge."
          }
        }
      ]
    }
