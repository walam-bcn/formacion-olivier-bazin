    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/nervi-vague#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Què és el to vagal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És la influència que exerceix el nervi vague sobre l'organisme en repòs. Un bon to vagal s'associa a una capacitat més gran per recuperar la calma després de l'estrès, i es pot estimar amb la variabilitat de la freqüència cardíaca."
          }
        },
        {
          "@type": "Question",
          "name": "Com s'estimula el nervi vague de manera natural?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Amb la respiració lenta i diafragmàtica, l'exhalació allargada, el mindfulness, el moviment suau com el ioga o el qigong, l'exercici regular, un bon descans i el contacte social. Són pràctiques senzilles que, mantingudes en el temps, afavoreixen el to vagal."
          }
        },
        {
          "@type": "Question",
          "name": "Què és la teoria polivagal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És un model proposat per Stephen Porges que descriu com el sistema nerviós alterna entre estats de seguretat, de mobilització i de bloqueig segons com percep l'entorn. És una guia útil per entendre les reaccions del cos davant l'estrès i per orientar les pràctiques que afavoreixen la calma."
          }
        },
        {
          "@type": "Question",
          "name": "L'osteopatia treballa el nervi vague?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'osteopatia cranial i visceral utilitza tècniques suaus sobre les zones relacionades amb el vague, com la base del crani, la regió cervical alta, el diafragma i l'abdomen, per reduir la tensió i afavorir la resposta de relaxació. La integrem amb la respiració i els hàbits."
          }
        },
        {
          "@type": "Question",
          "name": "Em pot ajudar amb l'ansietat o amb la digestió?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Regular el sistema nerviós et pot ajudar a viure amb menys tensió i a millorar les digestions relacionades amb l'estrès. Treballem tots dos aspectes de manera conjunta, amb respiració, teràpia manual, alimentació i hàbits."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions calen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada persona. Després de la primera visita et proposem un pla, que sol combinar unes poques sessions inicials amb pràctiques per a casa, perquè la regularitat és el que sosté els canvis."
          }
        }
      ]
