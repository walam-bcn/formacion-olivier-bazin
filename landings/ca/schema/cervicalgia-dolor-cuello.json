    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/cervicalgia-dolor-coll#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Què puc fer si tinc un torticoli?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mantingui el coll en moviment suau dins del que és tolerable i apliqui calor local. Sol millorar en pocs dies; si no és així, una valoració ajuda a recuperar la mobilitat. Pot consultar també la nostra pàgina de torticoli."
          }
        },
        {
          "@type": "Question",
          "name": "Atenen el dolor de coll després d'un cop de fuet cervical?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Un cop descartades lesions mitjançant la valoració mèdica d'urgències, treballem amb mobilitat suau i exercici progressiu per recuperar el coll."
          }
        },
        {
          "@type": "Question",
          "name": "El dolor de coll pot provocar mal de cap?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La tensió cervical es pot irradiar al clatell i al cap (cefalea cervicogènica). Si les cefalees són freqüents, consulti també la nostra pàgina de cefalees i migranya."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito una radiografia o una ressonància?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la majoria dels casos no és necessària. Es reserva per a situacions concretes, com un traumatisme o símptomes neurològics. Si ja té proves, porti-les a la primera visita."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. A la primera visita valorem la seva situació i li proposem un pla amb objectius clars i revisions periòdiques."
          }
        }
      ]
    }
