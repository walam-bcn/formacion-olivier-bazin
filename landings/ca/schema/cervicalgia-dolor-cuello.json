    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/cervicalgia-dolor-coll#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Què faig si tinc una torticoli?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mantén el coll en moviment suau dins del que toleres i aplica-hi calor local. Si en pocs dies no millora, una valoració ajuda a recuperar la mobilitat abans."
          }
        },
        {
          "@type": "Question",
          "name": "Atendeu la fuetada cervical després d'un accident?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, un cop descartades lesions pel teu metge, com a complement del seguiment mèdic, amb teràpia manual suau i exercici progressiu."
          }
        },
        {
          "@type": "Question",
          "name": "El dolor de coll pot provocar mal de cap?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La tensió cervical pot irradiar-se al clatell i al cap. Si els mals de cap són freqüents, consulta també la nostra pàgina de cefalees i migranya."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. A la primera visita valorem la teva situació i et proposem un pla amb objectius clars."
          }
        }
      ]
    }
