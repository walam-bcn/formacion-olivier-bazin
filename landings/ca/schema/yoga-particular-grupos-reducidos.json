    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/ioga-terapeutic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Necessito experiència prèvia en ioga?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La pràctica s'adapta al seu nivell i a la seva situació de salut, tant si no ha practicat mai ioga com si ja en té experiència."
          }
        },
        {
          "@type": "Question",
          "name": "Puc practicar ioga si tinc mal d'esquena?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la majoria dels casos, sí. Després de la valoració s'escullen els moviments que la seva esquena tolera bé i es progressa de manera gradual. Si el dolor és recent o molt intens, primer es valora el seu cas amb més detall."
          }
        },
        {
          "@type": "Question",
          "name": "En què es diferencia d'una classe de ioga en un gimnàs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el fet que la pràctica és individualitzada: parteix d'una valoració, s'adapta a la seva patologia o etapa vital, compta amb pautes per a casa i s'ajusta a cada sessió segons com es trobi."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del seu cas i dels seus objectius. Moltes persones noten canvis en poques setmanes si combinen les sessions amb les pautes per a casa. En la valoració inicial l'orientem sobre la freqüència més adequada."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa i com funciona la modalitat en línia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sessió particular de 60 minuts costa 50 €, i disposa d'un bo de 10 sessions + 1 de regal. Pot practicar des de casa en sessions particulars en línia o amb la subscripció, des de 25 € al mes. Només necessita roba còmoda, una estora i un espai tranquil."
          }
        }
      ]
    }
