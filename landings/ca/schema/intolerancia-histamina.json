    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/intolerancia-histamina#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quins aliments tenen més histamina?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sobretot els fermentats i curats: vi, cervesa, formatges curats, embotits, conserves de peix, xucrut o salsa de soja. Les restes de menjar guardades diversos dies també acumulen histamina."
          }
        },
        {
          "@type": "Question",
          "name": "La dieta baixa en histamina és per sempre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. És una fase temporal. Després reintroduïm aliments perquè la seva dieta sigui al més àmplia possible dins de la seva tolerància."
          }
        },
        {
          "@type": "Question",
          "name": "Té relació amb la migranya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En algunes persones la histamina és un desencadenant del mal de cap. Si és el seu cas, pot consultar també cefalees i migranya."
          }
        },
        {
          "@type": "Question",
          "name": "Puc prendre suplements de DAO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Poden ser útils en algunes persones com a suport a la dieta. Ho valorem amb vostè segons el seu cas."
          }
        }
      ]
    }
