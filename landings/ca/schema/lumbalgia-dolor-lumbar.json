    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/lumbalgia-dolor-lumbar#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Puc venir en plena fase aguda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En la fase aguda l'objectiu és alleujar el dolor i ajudar-lo a mantenir-se actiu dins del que és tolerable, que és el que més afavoreix la recuperació."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito una ressonància abans de la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No és imprescindible. En la majoria de les lumbàlgies el diagnòstic és clínic. Si ja disposa de proves, porti-les i les revisem juntament amb la seva història."
          }
        },
        {
          "@type": "Question",
          "name": "És millor fer repòs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El repòs al llit prolongat ja no es recomana. És preferible un repòs relatiu: reduir el que més fa mal i mantenir la resta de l'activitat."
          }
        },
        {
          "@type": "Question",
          "name": "Per què torna el dolor cada cert temps?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les recaigudes són habituals i solen relacionar-se amb la pèrdua de força, la inactivitat, l'estrès o el mal descans. Treballar aquests factors redueix la probabilitat de nous episodis."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. A la primera visita valorem la seva situació i li proposem un pla amb objectius clars i revisions periòdiques."
          }
        }
      ]
    }
