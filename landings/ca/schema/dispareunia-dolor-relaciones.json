    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dispareunia-dolor-relacions#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És normal tenir dolor en les relacions després del part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És freqüent, però no és una cosa que s'hagi d'acceptar. Convé valorar-ho, especialment si s'allarga més enllà dels primers mesos."
          }
        },
        {
          "@type": "Question",
          "name": "Feu tractament intern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El nostre abordatge és sempre extern."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em fan mal les relacions des que dono el pit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Durant la lactància els estrògens es mantenen baixos, cosa que pot reduir l'elasticitat i la hidratació de les mucoses vulvars i vaginals. Sol millorar quan es recupera el cicle, però convé comentar-ho amb la llevadora o la ginecòloga."
          }
        },
        {
          "@type": "Question",
          "name": "Tenir l'úter en retroversió vol dir que tindré dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No necessàriament. Segons els autors, una retroversió amb bona mobilitat sol tolerar-se bé; el que causa problemes és que l'úter estigui fixat i no es pugui moure."
          }
        }
      ]
    }
