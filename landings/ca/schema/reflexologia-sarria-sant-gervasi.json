    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/reflexologia-podal#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Fa mal la reflexologia podal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No n'hauria de fer. Algunes zones es poden notar més sensibles, però la pressió s'ajusta en tot moment a la seva tolerància. La majoria de les persones la viuen com una experiència molt agradable."
          }
        },
        {
          "@type": "Question",
          "name": "Quina diferència hi ha amb un massatge de peus?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La reflexologia segueix un recorregut sistemàtic per totes les zones de tots dos peus, amb pressió mantinguda i puntual, mentre que el massatge de peus treballa sobretot la musculatura amb maniobres de lliscament i pastat."
          }
        },
        {
          "@type": "Question",
          "name": "Puc rebre reflexologia si estic en tractament oncològic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, amb l'autorització del seu oncòleg. És una de les tècniques que recomanen les guies d'oncologia integrativa per alleujar el dolor durant el tractament, i s'adapta al seu estat a cada sessió."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Moltes persones noten una relaxació clara des de la primera sessió. Per a l'estrès o l'insomni se sol recomanar una sessió setmanal durant quatre a sis setmanes. L'orientem segons el seu cas."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa i tenen targetes regal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sessió de 60 minuts costa 70 €. Disposa d'un bo de 10 sessions + 1 de regal i de targetes regal: escrigui'ns per WhatsApp."
          }
        }
      ]
    }
  ]
