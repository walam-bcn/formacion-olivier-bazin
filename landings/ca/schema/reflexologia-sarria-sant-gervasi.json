    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/reflexologia-podal#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La reflexologia substitueix un tractament mèdic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'oferim com una tècnica de benestar i relaxació, complementària al seu tractament."
          }
        },
        {
          "@type": "Question",
          "name": "Puc rebre reflexologia si estic en tractament oncològic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, sempre amb l'autorització del seu metge. La guia SIO–ASCO contempla la reflexologia com a suport per al dolor durant el tractament del càncer. A WA LAM no tractem cap pacient oncològic sense autorització mèdica, ni amb reflexologia, ni amb drenatge, ni amb massatge."
          }
        },
        {
          "@type": "Question",
          "name": "Hi ha alguna contraindicació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Avisi'ns si té ferides, infeccions o problemes circulatoris als peus, o si està embarassada."
          }
        }
      ]
