        {
          "@type": "Question",
          "name": "Tot el recés és en silenci?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Habitualment practiquem en silenci, però no tota l'estona: hi ha moments d'explicació i de preguntes. A cada edició indiquem quan es practica en silenci."
          }
        },
