    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/colon-irritable-sibo#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hauré de fer la dieta FODMAP per sempre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La fase de reducció és temporal. Després reintroduïm els aliments a poc a poc per saber quins toleres i mantenir una alimentació variada."
          }
        },
        {
          "@type": "Question",
          "name": "Com sé si tinc SIBO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El SIBO s'estudia amb un test d'alè que sol demanar el metge. Si ja el tens, porta'l a la primera visita i l'integrem en el pla."
          }
        },
        {
          "@type": "Question",
          "name": "L'estrès pot causar còlon irritable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'estrès no n'és l'única causa, però hi influeix molt a través de l'eix intestí-cervell. Per això hi incloem eines com el curs MBSR."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els informes i proves que tinguis (analítiques, test d'alè, colonoscòpia) i, si pots, un registre d'uns dies del que menges i dels teus símptomes."
          }
        }
      ]
    }
