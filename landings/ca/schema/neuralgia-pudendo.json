    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/neuralgia-pudend#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Com sé si tinc neuràlgia del pudend?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El diagnòstic el fa un metge especialista a partir dels seus símptomes i de l'exploració. A WA LAM treballem en coordinació amb el seu metge."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu homes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El nostre abordatge del dolor pèlvic s'adreça a dones."
          }
        },
        {
          "@type": "Question",
          "name": "Per què el dolor empitjora en estar asseguda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En seure, el pes recau sobre la zona del conducte pudend, al costat de la tuberositat isquiàtica, i augmenta la pressió sobre un nervi que ja està irritat. Dreta o estirada aquesta pressió desapareix."
          }
        },
        {
          "@type": "Question",
          "name": "Pot aparèixer després d'un part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El part estira al màxim el nervi pudend, i en prop del 42 % dels parts vaginals el nervi mostra signes de sofriment. Un part llarg, un nadó gran o una episiotomia augmenten el risc."
          }
        },
        {
          "@type": "Question",
          "name": "Per què calen més sessions que en altres dolors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perquè el nervi pudend té moltes fibres sense mielina, respon més a poc a poc i sol portar temps irritat. Convé treballar-ne l'entorn amb suavitat i paciència."
          }
        }
      ]
    }
