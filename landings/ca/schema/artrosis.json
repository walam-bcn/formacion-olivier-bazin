    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/artrosi#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Puc fer exercici si tinc artrosi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'exercici adaptat és un dels pilars del tractament. L'ajustem a la teva articulació, el teu nivell i el teu dolor."
          }
        },
        {
          "@type": "Question",
          "name": "Perdre pes ajuda de debò?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En l'artrosi de genoll i maluc, reduir l'excés de pes disminueix la càrrega sobre l'articulació i sol alleujar el dolor."
          }
        },
        {
          "@type": "Question",
          "name": "Atenem l'artrosi de mans i de columna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. També la de mans i la de columna, amb un pla adaptat a cada zona. Si el dolor és sobretot lumbar, consulta també lumbàlgia."
          }
        },
        {
          "@type": "Question",
          "name": "És útil si ja m'han proposat una pròtesi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. T'ajudem a arribar a la cirurgia amb més força i mobilitat, cosa que afavoreix una recuperació més ràpida després."
          }
        }
      ]
    }
