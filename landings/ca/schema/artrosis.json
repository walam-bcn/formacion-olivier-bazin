    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/artrosi#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Puc fer exercici si tinc artrosi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'exercici adaptat és un dels pilars del tractament. S'ajusta a l'articulació afectada, a la seva condició física i al dolor de cada moment."
          }
        },
        {
          "@type": "Question",
          "name": "Perdre pes alleuja el dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En l'artrosi de genoll i de maluc, reduir l'excés de pes disminueix la càrrega sobre l'articulació i sol millorar el dolor i la funció."
          }
        },
        {
          "@type": "Question",
          "name": "L'artrosi de mans i de columna també es pot tractar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Cada localització requereix un pla propi. Si el dolor és sobretot lumbar, pot consultar també la pàgina de lumbàlgia."
          }
        },
        {
          "@type": "Question",
          "name": "Té sentit si ja m'han proposat una pròtesi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Arribar a la cirurgia amb més força i mobilitat afavoreix la recuperació posterior."
          }
        },
        {
          "@type": "Question",
          "name": "És normal que em faci més mal amb el fred?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Moltes persones noten més rigidesa amb el fred i la humitat. La calor local i mantenir l'activitat solen alleujar-la."
          }
        }
      ]
    }
