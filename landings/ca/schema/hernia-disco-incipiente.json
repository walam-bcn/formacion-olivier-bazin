    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/hernia-disc-incipient#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Una hèrnia de disc pot millorar sense cirurgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Moltes hèrnies milloren amb tractament conservador, i una part es reabsorbeix amb el temps. La cirurgia es reserva per a casos concrets, com un dèficit neurològic progressiu."
          }
        },
        {
          "@type": "Question",
          "name": "Puc fer exercici amb una protrusió?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, i és una part central del tractament. L'adaptem als seus símptomes i el progressem a poc a poc."
          }
        },
        {
          "@type": "Question",
          "name": "Tracten també l'hèrnia cervical?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, amb el mateix enfocament per fases. Si el dolor s'irradia al braç amb pèrdua de força que avança, consulti abans el seu metge de manera preferent."
          }
        },
        {
          "@type": "Question",
          "name": "Quina diferència hi ha entre protrusió i hèrnia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la protrusió el disc es bomba sense que es trenqui l'anell extern. En l'hèrnia, part del nucli surt a través de l'anell. Totes dues poden no donar símptomes i es valoren sempre juntament amb l'exploració."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito una ressonància?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sempre. Si ja la té, porti-la a la primera visita. S'indica quan hi ha signes d'alarma, dèficit neurològic o el dolor no millora després de diverses setmanes."
          }
        }
      ]
    }
