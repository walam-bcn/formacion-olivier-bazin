    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/reflux-acidesa#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quant de temps triga a notar-se la millora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Amb els canvis d'horaris i d'alimentació, moltes persones noten menys acidesa en poques setmanes. Ajustem el pla amb vostè fins a trobar el que funciona millor en el seu cas."
          }
        },
        {
          "@type": "Question",
          "name": "Quins canvis ajuden més?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sopar abans i més lleuger, no estirar-se just després de menjar, perdre pes si hi ha sobrepès, deixar el tabac i menjar amb calma. Els adaptem a la seva rutina."
          }
        },
        {
          "@type": "Question",
          "name": "L'estrès influeix en l'acidesa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'estrès augmenta la percepció dels símptomes i altera la digestió. Per això hi incloem respiració i regulació del sistema nerviós."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu la gastritis i les digestions pesades?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, la gastritis funcional i la dispèpsia. Si té senyals d'alarma, primer l'ha de valorar el seu metge."
          }
        }
      ]
    }
