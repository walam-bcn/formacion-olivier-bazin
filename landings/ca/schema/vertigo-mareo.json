    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/vertigen-mareig#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "El vertigen pot venir del coll?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El coll informa el cervell de la posició del cap, i la seva alteració pot contribuir al mareig i la inestabilitat (mareig cervicogènic). Es considera un cop descartades altres causes, i sol millorar en treballar la mobilitat cervical. Pot consultar també la nostra pàgina de cervicàlgia."
          }
        },
        {
          "@type": "Question",
          "name": "Què és la maniobra d'Epley?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És una seqüència de canvis de posició del cap i del cos que retorna els cristalls de l'oïda interna al seu lloc en el VPPB. Es fa quan el diagnòstic està confirmat i l'ha indicada el metge."
          }
        },
        {
          "@type": "Question",
          "name": "L'estrès pot causar mareig?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'estrès i l'ansietat poden mantenir o intensificar la sensació d'inestabilitat, sobretot després d'un episodi de vertigen. Per això, la regulació del sistema nerviós forma part de l'abordatge."
          }
        },
        {
          "@type": "Question",
          "name": "És millor fer repòs quan estic marejat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la fase molt aguda pot necessitar descansar unes hores. Després, convé reprendre el moviment de manera gradual: l'activitat ajuda el sistema de l'equilibri a compensar."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de la causa i de la seva evolució. En la primera visita valorem la seva situació i li proposem un pla amb objectius clars i revisions periòdiques."
          }
        }
      ]
    }
