      "mainEntity": [
        {
          "@type": "Question",
          "name": "Això substitueix un tractament de fertilitat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. És un acompanyament complementari. Les decisions diagnòstiques i de tractament corresponen a la teva ginecòloga o a la teva clínica de reproducció."
          }
        },
        {
          "@type": "Question",
          "name": "L'acupuntura millora les probabilitats d'embaràs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No hi ha proves que ho faci. Un assaig clínic amb 848 dones publicat a JAMA no va trobar diferències en la taxa de nascuts vius en comparació amb l'acupuntura simulada. Algunes persones la trien per benestar i per gestionar l'estrès; t'ho expliquem perquè decideixis amb informació."
          }
        },
        {
          "@type": "Question",
          "name": "Podem venir en parella?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Atenem tant de manera individual com en parella."
          }
        }
      ]
