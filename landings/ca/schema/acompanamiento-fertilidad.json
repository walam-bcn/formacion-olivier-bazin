    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/acompanyament-fertilitat#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Això substitueix un tractament de fertilitat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. És un acompanyament integratiu, en coordinació amb el seu equip mèdic. Les decisions diagnòstiques i de tractament corresponen a la seva ginecòloga o a la seva clínica de reproducció."
          }
        },
        {
          "@type": "Question",
          "name": "Què aporta l'acupuntura durant un tractament de fertilitat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Li pot ajudar a gestionar l'estrès i a tenir cura del seu benestar durant el procés, en coordinació amb la seva clínica de reproducció."
          }
        },
        {
          "@type": "Question",
          "name": "Podem venir en parella?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Atenem tant de manera individual com en parella."
          }
        },
        {
          "@type": "Question",
          "name": "Pot una apendicectomia antiga influir en la meva fertilitat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segons els autors, les adherències que deixa la cirurgia poden afectar l'ovari i la trompa drets, molt propers a l'apèndix. És un dels antecedents que es valoren, sempre sense prometre resultats."
          }
        },
        {
          "@type": "Question",
          "name": "En quin moment del cicle és millor la sessió?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els autors recomanen la setmana següent a la regla i tres sessions separades per un mes."
          }
        }
      ]
