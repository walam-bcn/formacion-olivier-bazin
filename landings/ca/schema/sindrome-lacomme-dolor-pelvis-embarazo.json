    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/sindrome-lacomme-dolor-pelvis-embaras#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La síndrome de Lacomme és perillosa per al nadó?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. És un quadre benigne de la mare, relacionat amb l'adaptació de la pelvis a l'embaràs. Pot molestar molt, però no afecta el nadó."
          }
        },
        {
          "@type": "Question",
          "name": "Em passarà després del part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la majoria dels casos, sí. Segons el llibre, en un 10 % de les dones pot persistir entre 12 i 18 mesos després del naixement; aleshores convé valorar-ho dins del postpart."
          }
        },
        {
          "@type": "Question",
          "name": "És segur el tractament osteopàtic durant l'embaràs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els autors consideren que hi té plenament cabuda, sempre amb un tacte molt lleuger, sessions curtes, tècniques suaus i sense maniobres brusques, i descartant abans les contraindicacions que ha de valorar el seu ginecòleg."
          }
        },
        {
          "@type": "Question",
          "name": "En quina setmana puc consultar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tan bon punt aparegui el dolor. Els autors proposen a més revisions en moments clau de l'embaràs, cap a les setmanes 12–14, 20, 28 i 32."
          }
        },
        {
          "@type": "Question",
          "name": "És el mateix que el dolor del lligament rodó?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El Lacomme fa mal al pubis, a les sacroilíaques i a la pelvis; la síndrome del lligament rodó dona punxades a l'engonal i a la fossa ilíaca en moure's, sobretot al segon trimestre."
          }
        }
      ]
    }
