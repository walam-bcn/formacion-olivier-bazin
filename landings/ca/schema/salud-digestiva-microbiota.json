    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/salut-digestiva-microbiota#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Feu estudi de microbiota?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'estudi de microbiota intestinal, que es deriva a un laboratori especialitzat, el valorem a la primera visita i el recomanem quan pot canviar el pla. Els resultats s'integren a l'informe de valoració, com expliquem a longevitat i prevenció. Si es planteja un estudi de paràsits, comprovem abans què inclou el perfil escollit per no duplicar proves."
          }
        },
        {
          "@type": "Question",
          "name": "Hauré de fer una dieta molt estricta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No per defecte. Algunes persones es beneficien de canvis temporals i guiats, però evitem restriccions prolongades sense motiu."
          }
        },
        {
          "@type": "Question",
          "name": "L'osteopatia visceral serveix per a la digestió?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pot ajudar algunes persones a sentir menys tensió abdominal i una millor mobilitat del diafragma. L'evidència científica és encara limitada, per això la proposem com a complement i no com a tractament únic."
          }
        },
        {
          "@type": "Question",
          "name": "Substitueix la consulta de digestiu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Si els teus símptomes requereixen estudi mèdic, t'ho indicarem. Et podem acompanyar en paral·lel."
          }
        }
      ]
