    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-oncologic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quines disciplines intervenen en l'abordatge del dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'osteopatia i l'acupuntura, integrades en un pla individual. Quan cal un programa de fisioteràpia, fem la derivació a un fisioterapeuta col·legiat."
          }
        },
        {
          "@type": "Question",
          "name": "Què necessito per començar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un document signat pel teu metge que autoritzi el tractament. Sense aquesta autorització no et podem atendre."
          }
        },
        {
          "@type": "Question",
          "name": "Puc venir durant la quimioteràpia o la radioteràpia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de la teva situació i del que indiqui el teu metge. L'acompanyament s'adapta a cada fase del tractament."
          }
        },
        {
          "@type": "Question",
          "name": "I si el tractament ja ha acabat però el dolor continua?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És freqüent: prop de quatre de cada deu persones mantenen dolor després del tractament. També et podem acompanyar en aquesta etapa, amb autorització mèdica."
          }
        },
        {
          "@type": "Question",
          "name": "Substitueix el meu tractament oncològic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. És un acompanyament complementari per alleujar el dolor i millorar la qualitat de vida."
          }
        }
      ]
    }
