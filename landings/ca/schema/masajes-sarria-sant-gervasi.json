    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/massatge-terapeutic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quina diferència hi ha entre el massatge terapèutic i el relaxant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El massatge terapèutic o descontracturant se centra en les zones de dolor i contractura, amb una pressió més profunda. El relaxant utilitza un ritme lent i una pressió moderada a tot el cos per reduir la tensió general i l'estrès."
          }
        },
        {
          "@type": "Question",
          "name": "Fa mal el massatge descontracturant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es pot notar intens sobre una contractura, però la pressió s'ajusta a la seva tolerància i no ha de resultar dolorós. És normal sentir la zona una mica sensible durant un o dos dies."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una contractura recent sol millorar en una a tres sessions. En el mal d'esquena persistent o la sobrecàrrega esportiva habitual sol ser útil una sessió setmanal o quinzenal durant unes setmanes. L'orientem segons el seu cas."
          }
        },
        {
          "@type": "Question",
          "name": "Quan és millor una valoració d'osteopatia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si el dolor és persistent, s'irradia a un braç o a una cama, o apareix després d'una lesió o una operació, convé començar per una valoració d'osteopatia per definir el tractament més adequat."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa i tenen targetes regal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sessió de massatge terapèutic de 60 minuts costa 70 €; la resta de modalitats tenen el preu indicat a cadascuna. Disposa de paquets de 10 sessions i de targetes regal: escrigui'ns per WhatsApp."
          }
        }
      ]
    }
