      "mainEntity": [
        {
          "@type": "Question",
          "name": "El tractament és intern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El nostre abordatge osteopàtic és sempre extern: treballem sobre l'abdomen, la pelvis, el sacre, el còccix i la zona lumbar, sense tècniques intracavitàries."
          }
        },
        {
          "@type": "Question",
          "name": "Atendeu homes amb dolor pelvià?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'atenció en salut pelviana de WA LAM s'adreça exclusivament a dones."
          }
        },
        {
          "@type": "Question",
          "name": "He de portar proves o informes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si té ecografies, analítiques o informes, porti'ls a la primera visita. Ens ajuden a entendre la seva situació i a orientar el pla."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas i del temps d'evolució. A la primera visita valorem la seva situació i li proposem un pla amb objectius clars."
          }
        }
      ]
