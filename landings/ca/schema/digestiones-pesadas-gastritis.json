    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/digestions-pesades-gastritis#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quina diferència hi ha entre dispèpsia funcional i gastritis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La gastritis és una inflamació de la mucosa de l'estómac que es confirma amb proves. En la dispèpsia funcional hi ha símptomes semblants, però sense una lesió que els expliqui: l'estómac funciona de manera més sensible."
          }
        },
        {
          "@type": "Question",
          "name": "I si tinc Helicobacter pylori?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El diagnòstic i el tractament antibiòtic els pauta el seu metge. En paral·lel, treballem amb vostè els hàbits, l'alimentació i l'estrès perquè el seu estómac es recuperi millor."
          }
        },
        {
          "@type": "Question",
          "name": "He de deixar de menjar molts aliments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No necessàriament. Busquem què li sent pitjor a vostè i ajustem quantitats, horaris i combinacions abans de plantejar restriccions."
          }
        },
        {
          "@type": "Question",
          "name": "L'estrès em pot provocar digestions pesades?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'estómac i el cervell estan molt connectats i la tensió mantinguda altera el buidatge i la sensibilitat de l'estómac. Per això incloem eines de regulació en el pla."
          }
        }
      ]
