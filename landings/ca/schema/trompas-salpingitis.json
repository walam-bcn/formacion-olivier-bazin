    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/trompes-salpingitis#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Si ja em van tractar la salpingitis, pot quedar alguna seqüela?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segons el llibre, tota infecció, fins i tot tractada a temps, deixa microadherències que poden restar mobilitat a la trompa. Són aquestes seqüeles mecàniques les que es valoren en osteopatia."
          }
        },
        {
          "@type": "Question",
          "name": "L'osteopatia pot desobstruir una trompa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No es pot prometre. Els autors creuen que alliberar el peritoneu i relaxar els espasmes afavoreix la funció de la trompa, però una obstrucció l'ha de valorar el vostre ginecòleg o la clínica de fertilitat."
          }
        },
        {
          "@type": "Question",
          "name": "Quan és millor fer les sessions si busco un embaràs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els autors proposen la setmana següent a la regla i tres sessions separades per un mes."
          }
        },
        {
          "@type": "Question",
          "name": "Què hi té a veure la meva apendicitis amb les trompes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'apèndix, la trompa i l'ovari drets són molt a prop; les adherències després d'una apendicectomia poden modificar les tensions del peritoneu al voltant de la trompa dreta."
          }
        },
        {
          "@type": "Question",
          "name": "Em faran una exploració interna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A WA LAM l'abordatge és sempre extern."
          }
        }
      ]
    }
