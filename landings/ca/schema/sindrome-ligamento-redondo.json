    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/sindrome-lligament-rodo#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És perillós per al nadó?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. És un dolor benigne i inofensiu, conseqüència de com s'adapta el lligament al creixement de l'úter."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em fa més mal a un costat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'úter no creix centrat: en la majoria de les dones gira i s'inclina cap a la dreta, cosa que tensa de manera desigual els dos lligaments rodons."
          }
        },
        {
          "@type": "Question",
          "name": "Quan sol aparèixer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sobretot al segon trimestre, quan l'úter surt de la pelvis i creix més de pressa. A partir del sisè mes, un dolor que baixa pel pubis fins al llavi major pot ser degut a l'artèria del lligament rodó."
          }
        },
        {
          "@type": "Question",
          "name": "Puc rebre osteopatia estant embarassada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, si el seu ginecòleg no ha detectat contraindicacions. Els autors demanen un tacte molt lleuger, sessions curtes i tècniques suaus, sense maniobres brusques."
          }
        },
        {
          "@type": "Question",
          "name": "Quina postura em pot alleujar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La postura de quatre grapes, recolzada en els avantbraços, uns cinc minuts al dia i amb la panxa ben relaxada, com si la deixés caure cap a terra."
          }
        }
      ]
    }
