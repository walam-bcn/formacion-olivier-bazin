    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/bruxisme-dolor-mandibular-atm#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "He de deixar d'utilitzar la fèrula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Si el seu dentista li ha indicat una fèrula de descàrrega, convé continuar utilitzant-la. L'abordatge de la musculatura, la tensió i l'estrès ajuda que la mandíbula es relaxi també durant el dia."
          }
        },
        {
          "@type": "Question",
          "name": "L'estrès influeix en el bruxisme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, de manera important. Per això el pla inclou eines per reduir l'activació del sistema nerviós. També pot consultar la nostra pàgina d'estrès i ansietat."
          }
        },
        {
          "@type": "Question",
          "name": "El dolor de mandíbula pot provocar mal de cap?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La sobrecàrrega dels músculs de la masticació pot provocar dolor a les temples i cefalea en despertar-se, i sovint s'associa a tensió al coll."
          }
        },
        {
          "@type": "Question",
          "name": "Són greus els espetecs de la mandíbula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els espetecs aïllats, sense dolor ni bloqueig, són freqüents i no solen requerir tractament. Convé valorar-los si s'acompanyen de dolor o de limitació en obrir la boca."
          }
        }
      ]
    }
