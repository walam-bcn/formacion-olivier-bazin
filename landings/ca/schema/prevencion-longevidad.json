    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/longevitat-prevencio-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Què és la medicina de longevitat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És un enfocament preventiu que busca allargar els anys viscuts amb bona salut. Valora de manera global els factors que determinen com envellim (metabolisme, inflamació, son, activitat física, alimentació, estrès i salut cognitiva) i dissenya un pla individual per actuar-hi abans que aparegui la malaltia."
          }
        },
        {
          "@type": "Question",
          "name": "Està basada en l'evidència científica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, en allò que té suport: l'activitat física, l'exercici de força, el son, l'alimentació de qualitat i el control dels factors de risc cardiovascular i metabòlic. Les eines emergents, com els rellotges epigenètics, s'interpreten amb cautela."
          }
        },
        {
          "@type": "Question",
          "name": "És segur?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El pla es basa en canvis d'hàbits i en teràpies de baix risc, adaptats a la seva història clínica i a la seva medicació. No inclou tractaments «antiaging» sense suport científic."
          }
        },
        {
          "@type": "Question",
          "name": "Quan es noten els resultats?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'energia i el descans solen millorar les primeres setmanes. Els canvis en els marcadors analítics i en la composició corporal requereixen, com a mínim, les 12 setmanes del programa."
          }
        },
        {
          "@type": "Question",
          "name": "Qui se'n pot beneficiar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Qualsevol persona adulta que vulgui anticipar-se: qui té antecedents familiars, nota pèrdua d'energia o de força, travessa la perimenopausa o vol millorar la seva salut metabòlica i cognitiva."
          }
        },
        {
          "@type": "Question",
          "name": "On es fa la consulta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Al centre WA LAM, al carrer del Bisbe Sivilla, 44, a Sarrià–Sant Gervasi (Barcelona)."
          }
        },
        {
          "@type": "Question",
          "name": "Cal que tingui algun problema de salut per venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La consulta està pensada precisament per a persones que volen anticipar-se."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les seves analítiques i proves mèdiques recents. Abans de la visita li demanarem que empleni el formulari de primera cita."
          }
        },
        {
          "@type": "Question",
          "name": "Demaneu proves addicionals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Només quan poden canviar el pla. La més habitual és l'estudi de microbiota intestinal; segons el seu cas, valorem altres proves o una consulta amb l'especialista."
          }
        },
        {
          "@type": "Question",
          "name": "Quines proves inclou la valoració?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segons el seu cas: analítica general i metabòlica, marcadors cardiovasculars, panells hormonals, proves genètiques, estudi de microbiota, epigenètica, valoració cognitiva, composició corporal i valoració del son i de l'estrès. Tot s'integra en un informe final amb el seu pla d'acció."
          }
        },
        {
          "@type": "Question",
          "name": "Recomaneu suplements?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Només quan hi ha una indicació clara i evidència que ho avali. No formen part del pla per defecte."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La primera visita dura 60 minuts i costa 90 €. Després rep un pressupost personalitzat per al seu programa; els costos de laboratori s'abonen a part."
          }
        },
        {
          "@type": "Question",
          "name": "Quant dura el programa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El programa base dura 12 setmanes, el temps mínim que necessiten els canvis en l'alimentació, la microbiota i els hàbits per consolidar-se, i es pot allargar segons la seva evolució."
          }
        }
      ]
    }
