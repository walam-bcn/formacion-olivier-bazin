    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/esgotament-fisic-emocional#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "En què es diferencia de la síndrome de fatiga crònica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'esgotament físic i emocional neix d'una sobrecàrrega sostinguda i millora quan es recupera la regulació. La fatiga crònica és un cansament persistent que no cedeix amb el descans i requereix un altre tipus d'abordatge."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Només les ganes d'entendre què et passa. Si tens analítiques recents, porta-les. Parlarem del teu son, la teva energia, la teva feina i el teu estrès per dissenyar un pla al teu ritme."
          }
        },
        {
          "@type": "Question",
          "name": "He d'estar de baixa per començar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Moltes persones comencen mentre continuen treballant; ajustem el pla al teu ritme i a la teva energia."
          }
        },
        {
          "@type": "Question",
          "name": "Quant triga a notar-se la millora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada persona i de quant de temps fa que vius al límit. A la primera visita valorem la teva situació i et proposem un pla."
          }
        }
      ]
    }
