    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/perdua-de-pes#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quant pes perdré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No li podem prometre una xifra: depèn de cada persona. Busquem una pèrdua progressiva que pugui mantenir en el temps."
          }
        },
        {
          "@type": "Question",
          "name": "L'acupuntura serveix per aprimar-se per si sola?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No ho plantegem així. A WA LAM l'acupuntura acompanya els canvis alimentaris, que són la base del programa. L'evidència sobre l'acupuntura aïllada per perdre pes és limitada."
          }
        },
        {
          "@type": "Question",
          "name": "Hauré de fer una dieta estricta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Treballem amb canvis progressius i adaptats a vostè, sense eliminar grups d'aliments sense una indicació clara."
          }
        },
        {
          "@type": "Question",
          "name": "Com és el seguiment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cada setmana controlem el pes i ajustem les pautes nutricionals. Les sessions d'acupuntura són dues per setmana, i la durada total depèn dels seus objectius."
          }
        }
      ]
    }
