      "mainEntity": [
        {
          "@type": "Question",
          "name": "Fa mal l'acupuntura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les agulles són molt fines. El més habitual és notar una punxada lleu o una sensació de pesadesa o formigueig a la zona."
          }
        },
        {
          "@type": "Question",
          "name": "És segura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Feta per un professional format i amb agulles estèrils d'un sol ús, els efectes adversos greus són molt poc freqüents. Avisa'ns si prens anticoagulants o estàs embarassada."
          }
        },
        {
          "@type": "Question",
          "name": "Feu servir l'acupuntura per perdre pes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: la incorporem a la consulta de pèrdua de pes, juntament amb canvis alimentaris."
          }
        },
        {
          "@type": "Question",
          "name": "I per deixar de fumar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, com a suport, en una consulta específica. T'expliquem què diu l'evidència a la pàgina d'acupuntura per deixar de fumar."
          }
        },
        {
          "@type": "Question",
          "name": "Vull aprendre MTC, on miro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La formació en medicina tradicional xinesa té la seva pròpia pàgina a la Healthy Lifestyle Academy."
          }
        }
      ]
