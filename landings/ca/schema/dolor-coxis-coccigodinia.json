    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-coccix-coccigodinia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pot aparèixer el dolor de còccix després del part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El part vaginal és una de les causes més característiques, sobretot si va ser difícil o amb fòrceps. Si el dolor dura més enllà de les primeres setmanes, convé valorar-lo."
          }
        },
        {
          "@type": "Question",
          "name": "El tractament és intern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'abordatge és sempre extern: es treballa a través de la pelvis, el sacre, els glutis, els lligaments, l'abdomen i la respiració."
          }
        },
        {
          "@type": "Question",
          "name": "Quin coixí és millor per al dolor de còccix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un coixí en falca amb un buit a la part posterior, que deixa el còccix sense suport i reparteix el pes sobre els isquis. Els coixins en forma de rosca solen descarregar menys el còccix."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em fa més mal en aixecar-me de la cadira?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En aixecar-se, el còccix deixa de rebre càrrega i els músculs i lligaments que s'hi insereixen, inclòs el sòl pelvià, l'estiren de cop. Inclinar-se cap endavant i recolzar-se a les cuixes en aixecar-se ho suavitza."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació té amb el sòl pelvià?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Part de la musculatura del sòl pelvià s'insereix al còccix. Davant del dolor, tendeix a contraure's de manera protectora, i aquesta tensió mantinguda pot perpetuar el dolor i produir molèsties en defecar o en les relacions. Per això es valora sempre en conjunt."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito una radiografia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sempre. La decideix el metge, sobretot per descartar una fractura o una malaltia greu. Si el dolor persisteix, les radiografies dinàmiques, asseguda i dreta, poden mostrar si el còccix està luxat o és hipermòbil."
          }
        },
        {
          "@type": "Question",
          "name": "Es cura el dolor de còccix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La majoria dels casos millora amb tractament conservador. Quan es fa persistent, el pla combina mesures posturals, exercici, tractament manual extern i, si cal, opcions mèdiques esglaonades que decideix l'especialista."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de l'origen del dolor, del temps d'evolució i de la resposta de cada persona. Després de la primera visita es proposa un pla amb objectius clars, exercicis per a casa i revisions que es van espaiant."
          }
        },
        {
          "@type": "Question",
          "name": "Una caiguda sobre el còccix pot influir en la bufeta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pot ser: una fixació del còccix cap endavant i cap a un costat relaxa el sistema de subjecció posterior de la bufeta i l'úter, i pot alterar el sosteniment i el tancament de la bufeta."
          }
        },
        {
          "@type": "Question",
          "name": "Em fa mal el còccix però les radiografies són normals, què pot ser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Moltes coccigodínies sense una fixació real de l'os es deuen a una irritació del nervi pudend. Convé valorar-lo juntament amb la pelvis i el perineu."
          }
        }
      ]
    }
