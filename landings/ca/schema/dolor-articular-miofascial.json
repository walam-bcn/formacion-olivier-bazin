    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-articular-miofascial#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quina diferència hi ha entre artrosi i artritis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'artrosi és un procés degeneratiu del cartílag, amb un dolor que empitjora amb l'ús. L'artritis és una inflamació de l'articulació, amb inflor, calor i rigidesa matinal prolongada, i requereix una valoració mèdica per conèixer-ne la causa."
          }
        },
        {
          "@type": "Question",
          "name": "Puc fer exercici si tinc artrosi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'exercici adaptat és una de les mesures amb més suport científic en l'artrosi. L'ajustem a la seva articulació, al seu nivell físic i a la fase del seu dolor."
          }
        },
        {
          "@type": "Question",
          "name": "Què és un punt gallet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És una zona hipersensible dins d'un múscul, palpable com un nòdul o una banda tensa. En pressionar-la reprodueix el dolor de la persona, de vegades a distància del mateix punt."
          }
        },
        {
          "@type": "Question",
          "name": "És el mateix el dolor miofascial que la fibromiàlgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El dolor miofascial és regional i es relaciona amb punts gallet concrets; la fibromiàlgia cursa amb dolor generalitzat, fatiga i son no reparador."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito una radiografia abans de la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No és imprescindible. Si disposa de proves o informes recents, porti'ls; si calguessin altres proves, l'hi indicarem."
          }
        }
      ]
