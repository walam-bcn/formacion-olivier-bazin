      "mainEntity": [
        {
          "@type": "Question",
          "name": "Necessito experiència prèvia en meditació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El programa està dissenyat per a persones sense experiència."
          }
        },
        {
          "@type": "Question",
          "name": "Quant de temps cal practicar a casa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre 30 i 45 minuts al dia, amb àudios guiats. És una part essencial del programa."
          }
        },
        {
          "@type": "Question",
          "name": "És el mateix que una classe de relaxació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La relaxació pot aparèixer, però no n'és l'objectiu. L'MBSR entrena l'atenció i la manera de relacionar-te amb l'experiència, inclosa la incòmoda."
          }
        }
      ]
