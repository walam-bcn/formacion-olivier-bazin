    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/bufeta-hiperactiva-urgencia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És normal tenir ganes d'orinar amb poca orina?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El primer desig sol aparèixer cap als 150 ml. Si noteu ganes urgents amb molt menys, la bufeta pot estar hipersensible i convé valorar-ho."
          }
        },
        {
          "@type": "Question",
          "name": "He de beure menys per anar menys al lavabo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. És millor beure sovint i en petites quantitats, perquè molta aigua de cop augmenta la tensió de la paret de la bufeta."
          }
        },
        {
          "@type": "Question",
          "name": "Si les anàlisis estan bé, per què tinc símptomes de cistitis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "S'anomenen cistàlgies les molèsties vesicals sense infecció. Solen ser degudes a una irritació mecànica de la base de la bufeta i, a la pràctica clínica, sovint responen bé al treball manual."
          }
        },
        {
          "@type": "Question",
          "name": "Quan és millor fer les sessions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general, la setmana següent a la regla, quan la base de la bufeta està menys sensible."
          }
        },
        {
          "@type": "Question",
          "name": "Té relació amb l'estrès?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En la bufeta hipersensible, allò local i allò central són interdependents: les tensions emocionals hi influeixen."
          }
        }
      ]
    }
