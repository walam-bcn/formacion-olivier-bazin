    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/hipotiroidisme-hashimoto#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "He de deixar o canviar la meva medicació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La medicació i les analítiques de control són competència del teu endocrí. L'acompanyament és complementari i no modifica el teu tractament."
          }
        },
        {
          "@type": "Question",
          "name": "He de prendre suplements de seleni o iode?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No pel teu compte. L'excés de iode pot ser perjudicial en la tiroïditis. Qualsevol suplement l'ha de valorar el teu metge a partir de les teves analítiques."
          }
        },
        {
          "@type": "Question",
          "name": "Cal seguir una dieta sense gluten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Només si tens celiaquia o una sensibilitat confirmada. En la resta de casos prioritzem una alimentació variada, rica en aliments frescos i adaptada a les teves digestions."
          }
        },
        {
          "@type": "Question",
          "name": "Per què continuo amb cansament si les analítiques estan bé?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El cansament pot tenir diversos factors: el son, l'estrès, nivells baixos de ferro o de vitamina D, o les digestions. Els revisem amb tu a la primera visita."
          }
        }
      ]
    }
