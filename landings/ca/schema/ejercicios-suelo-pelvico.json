    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/exercicis-sol-pelvia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quins són els errors més freqüents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aguantar la respiració, empènyer cap avall en lloc d'elevar, i prémer els glutis, les cuixes o l'abdomen en comptes del sòl pelvià. També és habitual no relaxar del tot entre repeticions. Si dubta, una valoració l'ajuda a corregir-ho."
          }
        },
        {
          "@type": "Question",
          "name": "Els puc fer durant l'embaràs i el postpart?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, i és una de les etapes en què més ajuden. En el postpart es comença de manera suau amb la respiració i contraccions lleugeres, i es progressa a poc a poc. Més informació a embaràs i postpart."
          }
        },
        {
          "@type": "Question",
          "name": "Serveixen a la menopausa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Amb la baixada d'estrògens els teixits perden elasticitat i força, i entrenar el sòl pelvià ajuda a mantenir la continència i el suport dels òrgans. Combina-ho amb activitat física regular."
          }
        },
        {
          "@type": "Question",
          "name": "Quan convé demanar una valoració?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si no aconsegueix localitzar la musculatura, si les pèrdues o la sensació de pes no milloren després d'unes setmanes de pràctica, si nota dolor en fer els exercicis o en les relacions, o després d'un part. Pot ampliar informació a sòl pelvià."
          }
        }
      ]
    }
