    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/cicatrius-episiotomia-cesaria#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan puc començar a tractar la meva cicatriu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Convé esperar que l'úter recuperi la seva mida (unes 6–8 setmanes) o el retorn de la regla, llevat de parts difícils que justifiquin una consulta abans. La ferida ha d'estar ben tancada."
          }
        },
        {
          "@type": "Question",
          "name": "La meva cicatriu és antiga, encara es pot treballar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La fibrosi i les adherències es poden valorar anys després del part; les pèrdues d'elasticitat solen respondre millor que els grans esquinçaments."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em fa mal en les relacions si la cicatriu sembla ben curada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La part visible pot estar bé i quedar fibrosi o tensió als plans profunds. A més, després del part i durant la lactància baixen els estrògens, cosa que redueix l'elasticitat de les mucoses."
          }
        },
        {
          "@type": "Question",
          "name": "La cesària deixa adherències?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Com tota cirurgia abdominopelviana, en pot deixar encara que estigui molt ben feta. Moltes no donen símptomes; quan limiten la mobilitat dels òrgans, es poden relacionar amb dolor pelvià o lumbar."
          }
        },
        {
          "@type": "Question",
          "name": "Quina cura de la pell necessita la cicatriu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Massatge suau amb crema hidratant quan la ferida estigui tancada i protecció solar alta en les cicatrius exposades durant el primer any."
          }
        }
      ]
    }
