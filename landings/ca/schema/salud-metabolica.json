    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/salut-metabolica#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les teves analítiques recents (colesterol, glucosa, hemoglobina glicada, perfil hepàtic), les teves xifres de tensió si les controles i la llista del que prens. Així podem mesurar el teu progrés."
          }
        },
        {
          "@type": "Question",
          "name": "Quin exercici és millor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La combinació regular d'exercici aeròbic i de força. L'important és començar al teu nivell i progressar de mica en mica."
          }
        },
        {
          "@type": "Question",
          "name": "El fetge gras pot millorar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, respon bé a la pèrdua de pes moderada, l'alimentació mediterrània i l'exercici. El teu metge en farà el seguiment amb analítiques i ecografia."
          }
        },
        {
          "@type": "Question",
          "name": "Cada quant tindré seguiment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ho acordem a la primera visita segons els teus objectius. Els canvis d'hàbits necessiten constància, per això plantegem un seguiment progressiu."
          }
        }
      ]
    }
