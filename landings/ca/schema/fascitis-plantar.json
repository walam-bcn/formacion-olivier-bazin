    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/fasciitis-plantar#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quant triga a millorar la fasciïtis plantar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del temps d'evolució i de la càrrega diària. Moltes persones noten millora en poques setmanes en ajustar la càrrega i fer els exercicis amb constància; la recuperació completa pot portar diversos mesos."
          }
        },
        {
          "@type": "Question",
          "name": "He de deixar de caminar o de córrer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Habitualment no cal deixar-ho del tot. S'ajusten el volum i la intensitat perquè el teixit es recuperi mentre vostè manté l'activitat."
          }
        },
        {
          "@type": "Question",
          "name": "L'esperó calcani és la causa del dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No necessàriament. L'esperó és una troballa freqüent a la radiografia, també en persones sense dolor, i no sol canviar el tractament."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito plantilles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sempre. En la valoració s'estudia si una plantilla, una talonera o un canvi de calçat el poden ajudar en la fase de més dolor."
          }
        }
      ]
    }
