    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/manipulacions-neuroviscerals#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És el mateix que l'osteopatia visceral?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'osteopatia visceral treballa sobre els òrgans i les seves fàscies; la manipulació neural, sobre els nervis i les meninges. Totes dues formen part del mètode Barral i sovint es combinen."
          }
        },
        {
          "@type": "Question",
          "name": "Pot ajudar després d'un cop de fuet cervical?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És un dels àmbits en què més s'aplica. Abans descartem signes d'alarma i, si cal, li demanem que consulti el seu metge. Després valorem la columna, el crani, els nervis i les meninges."
          }
        },
        {
          "@type": "Question",
          "name": "Fa mal la manipulació neural?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No acostuma a fer mal. Les tècniques són molt suaus; alguns punts del recorregut d'un nervi es poden notar sensibles en palpar-los."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació té amb el nervi vague?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El nervi vague connecta l'encèfal amb el cor, els pulmons i l'aparell digestiu. La vessant neurovisceral el valora al llarg del seu recorregut, juntament amb el diafragma i els altres nervis dels òrgans."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del seu cas i de com respongui. Després de la primera sessió l'orientem sobre la freqüència; sovint s'espaien una o dues setmanes."
          }
        }
      ]
    }
  ]
