    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-ovari-quists-ovari#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Per què em fa mal l'engonal o la cuixa si el problema és l'ovari?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els nervis de l'ovari connecten amb els que porten la sensibilitat de la paret abdominal baixa, l'engonal i la cuixa, i l'ovari pot estar a prop del nervi obturador. Per això el seu dolor es pot notar lluny."
          }
        },
        {
          "@type": "Question",
          "name": "Per què el dolor d'ovaris em dona nàusees?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'ovari i la trompa reben fibres del nervi vague, que també regula la digestió."
          }
        },
        {
          "@type": "Question",
          "name": "L'osteopatia tracta els quists d'ovari?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Un quist l'ha de diagnosticar i seguir el vostre ginecòleg. L'osteopatia s'ocupa de la mobilitat dels teixits que envolten l'ovari i del dolor d'origen mecànic."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em fa més mal l'ovari esquerre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es relaciona amb el seu drenatge venós cap al ronyó esquerre i amb la tendència del coll de l'úter a fixar-se cap enrere i cap a l'esquerra, cosa que pot congestionar aquest ovari."
          }
        },
        {
          "@type": "Question",
          "name": "Una ciàtica pot venir de l'ovari?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En dones que han tingut fills o de més edat, l'ovari pot irritar els nervis de la natja i del piriforme i causar una ciàtica alta que empitjora abans de la regla. Abans, el seu metge ha de descartar altres causes."
          }
        }
      ]
    }
