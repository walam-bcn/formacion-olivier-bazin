    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/fisioterapia-sarria-sant-gervasi#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Necessito una prescripció mèdica per anar al fisioterapeuta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No és imprescindible per a una consulta privada. Tot i així, si teniu informes, proves d'imatge o indicacions del vostre metge, convé portar-los, i en alguns casos, com el tractament oncològic o el postoperatori immediat, és important que el vostre equip mèdic n'estigui assabentat."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del problema, del temps que fa que el teniu i de com respongui el vostre cos. Després de la primera valoració se us explicarà un pla orientatiu, que es revisa segons l'evolució. La feina que feu a casa influeix molt en el resultat."
          }
        },
        {
          "@type": "Question",
          "name": "La teràpia manual fa mal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No hauria de ser una experiència desagradable. Podeu notar pressió o una certa molèstia en una zona sensible, però la intensitat s'adapta al que toleréu i podeu demanar que s'ajusti en qualsevol moment."
          }
        },
        {
          "@type": "Question",
          "name": "Quina roba he de portar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roba còmoda que permeti moure's i que deixi explorar la zona que us molesta. Si la sessió inclou exercici, millor roba esportiva."
          }
        },
        {
          "@type": "Question",
          "name": "Quan puc començar la fisioteràpia després d'una cirurgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del tipus d'intervenció i del que indiqui el vostre cirurgià o el vostre metge. En alguns casos es pot començar molt aviat i en d'altres convé esperar que la ferida tanqui. L'important és no deixar passar massa temps, perquè la cicatriu i els teixits s'organitzen les primeres setmanes."
          }
        },
        {
          "@type": "Question",
          "name": "És segur fer exercici durant el tractament del càncer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, sempre que estigui adaptat a la vostra situació i coordinat amb el vostre equip mèdic. El programa s'ajusta als símptomes, als valors de les anàlisis i a la fase del tractament, i es modifica els dies que us trobeu pitjor."
          }
        },
        {
          "@type": "Question",
          "name": "Es pot fer fisioteràpia durant tot l'embaràs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general sí, adaptant les posicions i la intensitat a cada trimestre i amb un abordatge extern i suau. Si el vostre embaràs és de risc o el ginecòleg o la llevadora us han indicat alguna restricció, comenteu-ho abans de començar."
          }
        },
        {
          "@type": "Question",
          "name": "A partir de quina edat es pot portar un nadó al fisioterapeuta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Des dels primers dies de vida. Com més aviat es detecta una asimetria del cap o una preferència marcada per girar cap a un costat, més fàcil sol ser corregir-la. La valoració es coordina sempre amb el seguiment del pediatre."
          }
        }
      ]
    }
