      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quines disciplines intervenen en l'abordatge del dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'osteopatia i l'acupuntura, integrades en un pla individual. Quan cal un programa de fisioteràpia, fem la derivació a un fisioterapeuta col·legiat."
          }
        },
        {
          "@type": "Question",
          "name": "L'acupuntura serveix per a la migranya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segons la revisió Cochrane de 2016, una pauta d'almenys sis sessions pot reduir la freqüència de la migranya episòdica, amb resultats comparables als fàrmacs preventius."
          }
        },
        {
          "@type": "Question",
          "name": "He de deixar la meva medicació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Qualsevol canvi en la medicació el decideix el teu metge."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu la cefalea cervicogènica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, amb tècniques manuals de la regió cervical, exercici i regulació de l'estrès."
          }
        }
