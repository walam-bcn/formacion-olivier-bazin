    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/cefalees-migranya#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Com sé si tinc migranya o cefalea tensional?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La migranya sol ser pulsàtil, d'un costat, empitjora en moure's i va acompanyada de nàusees o molèstia amb la llum i el soroll. La cefalea tensional és una pressió a tots dos costats, més lleu i sense nàusees. La valoració clínica permet diferenciar-les i descartar altres causes."
          }
        },
        {
          "@type": "Question",
          "name": "L'acupuntura serveix per a la migranya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La revisió Cochrane del 2016 va concloure que una pauta d'almenys sis sessions d'acupuntura redueix la freqüència de la migranya episòdica, amb resultats comparables als dels fàrmacs preventius."
          }
        },
        {
          "@type": "Question",
          "name": "Quin paper té l'alimentació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El dejuni, l'alcohol o alguns aliments poden desencadenar crisis en persones sensibles, tot i que no en totes. El diari de cefalees ajuda a identificar els seus desencadenants i a evitar restriccions innecessàries."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els seus informes mèdics, la llista de la medicació que pren i, si el té, un registre dels seus mals de cap de les últimes setmanes."
          }
        }
      ]
    }
