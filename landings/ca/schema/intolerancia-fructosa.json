    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/intolerancia-fructosa#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És el mateix que la intolerància hereditària a la fructosa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'hereditària és una malaltia genètica rara que requereix diagnòstic i seguiment mèdic. La malabsorció de fructosa és freqüent i es maneja amb canvis en l'alimentació."
          }
        },
        {
          "@type": "Question",
          "name": "He de deixar la fruita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Algunes fruites, com els cítrics, el kiwi o els fruits vermells, se solen tolerar bé en racions moderades. Es tracta de triar i repartir."
          }
        },
        {
          "@type": "Question",
          "name": "Quant dura la dieta baixa en FODMAP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La fase restrictiva és breu, normalment de dues a sis setmanes. Després reintroduïm els aliments de manera progressiva."
          }
        },
        {
          "@type": "Question",
          "name": "I si a més tinc còlon irritable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És habitual que coincideixin. El pla integra també l'abordatge del còlon irritable i el SIBO."
          }
        }
      ]
    }
