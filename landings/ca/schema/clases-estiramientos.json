    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/classes-estiraments#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Cal ser flexible per començar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Les classes parteixen del seu punt de partida i progressen de manera gradual. La flexibilitat es guanya amb la pràctica regular, a qualsevol edat."
          }
        },
        {
          "@type": "Question",
          "name": "Són adequades per a persones grans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Els exercicis s'adapten amb cadira i suports, i es combinen amb treball de força i equilibri, que és el més útil per mantenir l'autonomia i prevenir caigudes."
          }
        },
        {
          "@type": "Question",
          "name": "Puc fer estiraments si tinc ciàtica o mal lumbar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la majoria dels casos, sí. Es trien els moviments que la seva esquena tolera bé i s'eviten els que irradien el dolor. Si el dolor és recent o intens, primer es valora el seu cas amb més detall."
          }
        },
        {
          "@type": "Question",
          "name": "Cada quant convé estirar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El recomanable és practicar almenys dos o tres dies per setmana. Moltes persones noten menys rigidesa en poques setmanes si combinen la classe amb els exercicis per a casa."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa i què he de portar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La classe de 60 minuts costa 60 € i disposa d'un bo de 10 classes + 1 de regal. Només necessita roba còmoda que li permeti moure's amb llibertat."
          }
        }
      ]
    }
  ]
