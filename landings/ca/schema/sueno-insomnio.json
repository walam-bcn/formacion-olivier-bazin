    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/son-insomni#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan es considera que tinc insomni crònic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quan et costa adormir-te o mantenir el son almenys tres nits per setmana durant tres mesos, i això afecta el teu dia."
          }
        },
        {
          "@type": "Question",
          "name": "Dormo vuit hores i em llevo esgotada. Per què?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pot ser degut a un son fragmentat, a un ritme circadiari desajustat, a l'estrès, a canvis hormonals o a un trastorn com l'apnea. A la primera visita revisem aquests factors i, si cal, et derivem a una unitat del son."
          }
        },
        {
          "@type": "Question",
          "name": "Dormir malament durant anys augmenta el risc d'alzheimer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els estudis observen una associació entre dormir poc a la mitjana edat i un risc més alt de demència, però no demostren una relació causal. Tenir cura del son és, en qualsevol cas, una de les mesures preventives més raonables."
          }
        },
        {
          "@type": "Question",
          "name": "He de deixar les pastilles per dormir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sense parlar-ne amb el teu metge. Qualsevol canvi en la medicació s'ha de fer amb la seva supervisió."
          }
        },
        {
          "@type": "Question",
          "name": "Oferiu teràpia cognitivoconductual per a l'insomni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La TCC-I és el tractament de primera elecció. Si necessites un programa complet de TCC-I, et derivem a un psicòleg especialitzat en son."
          }
        },
        {
          "@type": "Question",
          "name": "Quan he d'anar a una unitat del son?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si ronques fort amb pauses en la respiració, tens molta somnolència durant el dia o sents la necessitat de moure les cames a la nit."
          }
        }
      ]
    }
