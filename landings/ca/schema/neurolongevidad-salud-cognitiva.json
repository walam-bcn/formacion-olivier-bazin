    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/salut-cognitiva-sarria-sant-gervasi-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Feu diagnòstic de deteriorament cognitiu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Si els oblits són freqüents o progressius, el diagnòstic correspon al teu metge o a un neuròleg. Et podem acompanyar en els hàbits i en la regulació de l'estrès i del son."
          }
        },
        {
          "@type": "Question",
          "name": "Què és la neuroregulació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És una forma d'estimulació elèctrica de baixa intensitat que s'aplica sobre la pell amb elèctrodes, sense agulles. Encara no l'oferim; quan la incorporem, ho anunciarem en aquesta pàgina."
          }
        },
        {
          "@type": "Question",
          "name": "Oferiu estimulació transcranial?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Encara no. Si la incorporem, s'aplicarà només quan hi hagi una indicació avalada per l'evidència i en coordinació amb el teu metge. En persones sanes no ha demostrat millorar la memòria ni l'atenció."
          }
        },
        {
          "@type": "Question",
          "name": "A partir de quina edat té sentit cuidar-se?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els factors de risc actuen al llarg de tota la vida, i la mitjana edat és una etapa clau per a la prevenció."
          }
        }
      ]
    }
