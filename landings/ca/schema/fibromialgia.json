    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/fibromialgia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La fibromiàlgia té tractament?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Un abordatge que combini educació, exercici gradual, regulació de l'estrès i cura del son pot reduir el dolor i la fatiga i millorar la qualitat de vida. Treballem amb objectius realistes i un pla que s'ajusta a la seva evolució."
          }
        },
        {
          "@type": "Question",
          "name": "L'exercici pot empitjorar el dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si es dosifica bé, no. Es comença per un nivell còmode i s'augmenta de manera progressiva, respectant els dies de més dolor. És normal notar alguna molèstia al principi, que sol disminuir amb la constància."
          }
        },
        {
          "@type": "Question",
          "name": "Per què les proves surten normals si tinc tant de dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perquè la fibromiàlgia no es deu a una lesió dels teixits, sinó a un processament alterat del dolor en el sistema nerviós. Que les proves siguin normals no vol dir que el dolor no sigui real."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els seus informes mèdics, les analítiques recents i la llista de la medicació que pren. Si li és possible, unes notes sobre com varien el seu dolor, el seu son i la seva energia al llarg de la setmana."
          }
        }
      ]
