    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/fibromialgia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Es pot millorar la fibromiàlgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, és possible reduir el dolor i la fatiga i recuperar activitat. Treballem amb objectius realistes i un pla que s'ajusta a com respons."
          }
        },
        {
          "@type": "Question",
          "name": "L'exercici no empitjora el dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si es dosifica bé, no. Comencem en un nivell còmode i augmentem de manera gradual, respectant els dies de més dolor."
          }
        },
        {
          "@type": "Question",
          "name": "L'acupuntura és adequada si tinc molta sensibilitat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Adaptem el nombre d'agulles, l'estimulació i la durada de la sessió a la teva tolerància."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els teus informes i analítiques recents, la llista del que prens i, si pots, unes notes sobre com varien el teu dolor, el teu son i la teva energia al llarg de la setmana."
          }
        }
      ]
    }
