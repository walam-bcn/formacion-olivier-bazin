    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/estres-ansietat#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Això substitueix la teràpia psicològica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Treballem la dimensió corporal i fisiològica de l'estrès. Si la seva situació requereix psicoteràpia o tractament mèdic, l'adrecem al professional corresponent."
          }
        },
        {
          "@type": "Question",
          "name": "Quina diferència hi ha entre la consulta individual i el MBSR?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La consulta individual s'adapta a la seva situació concreta. El MBSR és un programa grupal estructurat de 8 setmanes amb dates i inscripció pròpies. Moltes persones combinen totes dues opcions."
          }
        },
        {
          "@type": "Question",
          "name": "L'osteopatia ajuda amb l'estrès?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pot ajudar a alleujar la tensió física associada i a millorar la percepció corporal, però no actua sobre les causes de l'estrès. Per això la proposem dins d'un pla més ampli."
          }
        },
        {
          "@type": "Question",
          "name": "Tinc crisis d'ansietat. Puc venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, però si les crisis són freqüents o intenses és important que també consulti amb un professional de salut mental. Escrigui'ns i en parlem."
          }
        }
      ]
    }
