    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/contractures-estrips-musculars#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És millor el repòs absolut després d'un trencament fibril·lar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els primers dies convé protegir la zona. Després, el múscul es repara millor amb una càrrega progressiva i ben dosificada."
          }
        },
        {
          "@type": "Question",
          "name": "Quan podré tornar a fer esport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del grau de la lesió i de la seva activitat. El retorn es decideix amb criteris de força, mobilitat i absència de dolor."
          }
        },
        {
          "@type": "Question",
          "name": "És millor aplicar calor o fred?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En un trencament recent, fred durant els primers dies. En una contractura, la calor local sol alleujar la tensió."
          }
        },
        {
          "@type": "Question",
          "name": "Per què es repeteixen les meves contractures?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hi solen influir la sobrecàrrega, les postures mantingudes, la manca de força, l'estrès i el descans. Per això es revisen tots aquests factors."
          }
        },
        {
          "@type": "Question",
          "name": "I si el que tinc és una torçada de turmell?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les lesions de lligaments es tracten de manera específica. Pot consultar la pàgina d'esquinços."
          }
        }
      ]
