    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/contractures-estrips-musculars#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És millor el repòs absolut després d'un trencament fibril·lar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els primers dies convé protegir la zona, però el múscul es recupera millor amb una càrrega progressiva i ben dosificada. T'indiquem què fer en cada fase."
          }
        },
        {
          "@type": "Question",
          "name": "Quan podré tornar a fer esport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del tipus de lesió i de la teva activitat. Marquem criteris clars de força, mobilitat i absència de dolor perquè el retorn sigui segur."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu esquinços de turmell?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, els esquinços lleus i les molèsties que queden després d'un esquinç. Si no pots recolzar el peu, primer t'ha de valorar un metge."
          }
        },
        {
          "@type": "Question",
          "name": "Per què es repeteixen les meves contractures?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hi solen influir la sobrecàrrega, les postures mantingudes, la manca de força, l'estrès i el descans. Revisem tots aquests factors per reduir les recaigudes."
          }
        }
      ]
    }
