    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/esquincos#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan puc començar la recuperació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un cop descartada una fractura, des dels primers dies. La mobilització precoç i progressiva afavoreix una millor evolució."
          }
        },
        {
          "@type": "Question",
          "name": "Què és la propiocepció?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És la capacitat del sistema nerviós per percebre la posició d'una articulació. Després d'un esquinç s'altera, i entrenar-la ajuda a prevenir noves torçades."
          }
        },
        {
          "@type": "Question",
          "name": "També es tracten els esquinços de genoll i de canell?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, en la fase de recuperació. Si se sospita un trencament dels lligaments encreuats o una inestabilitat important, cal abans una valoració traumatològica. Si li preocupa el genoll, consulti també dolor de genoll."
          }
        },
        {
          "@type": "Question",
          "name": "Quan puc tornar a fer esport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quan hagi recuperat la mobilitat, la força i l'equilibri, i toleri sense dolor els gestos del seu esport. El retorn es planifica per etapes."
          }
        },
        {
          "@type": "Question",
          "name": "Què és un esquinç mal curat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És el que deixa dolor, inflor o sensació d'inestabilitat setmanes després de la lesió. Sol millorar amb un programa específic de força i propiocepció."
          }
        }
      ]
    }
