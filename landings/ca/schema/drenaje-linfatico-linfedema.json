      "mainEntity": [
        {
          "@type": "Question",
          "name": "Substitueix el tractament del meu metge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El tractament es fa en coordinació amb el teu metge especialista en limfedema: l'especialista s'encarrega de la valoració, les mesures i la indicació de la compressió, i WA LAM del drenatge limfàtic manual."
          }
        },
        {
          "@type": "Question",
          "name": "Es pot fer acupuntura si tinc limfedema?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, com a complement, però sense punxar mai el braç o la cama afectats."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito autorització mèdica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Sense l'autorització del teu metge no tractem cap pacient oncològic, ni amb drenatge, ni amb reflexologia, ni amb massatge."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa?",
          "acceptedAnswer": {
            "@type": "Answer",
