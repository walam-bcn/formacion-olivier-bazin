    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/prostata-salut-pelviana-masculina#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La prostatitis és sempre una infecció?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La forma més freqüent és la síndrome de dolor pelvià crònic, en què no es troba cap bacteri i el sòl pelvià i el sistema nerviós hi tenen un paper important."
          }
        },
        {
          "@type": "Question",
          "name": "L'home també té sòl pelvià?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Sosté la bufeta i el recte, ajuda a controlar l'orina i participa en l'erecció i l'ejaculació."
          }
        },
        {
          "@type": "Question",
          "name": "La pròstata pot donar dolor d'esquena?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Comparteix innervació amb la zona lumbar baixa i el sacre, i la seva irritació es pot sentir com a dolor lumbar referit."
          }
        },
        {
          "@type": "Question",
          "name": "El tractament és intern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A WA LAM l'abordatge és sempre manual i extern."
          }
        },
        {
          "@type": "Question",
          "name": "Puc venir després d'una operació de pròstata?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, quan el seu uròleg ho autoritzi. El treball del sòl pelvià i de les cicatrius ajuda a recuperar el control de l'orina."
          }
        }
      ]
    }
