    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/tenosinovitis-de-quervain#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "On fa mal exactament la tenosinovitis de De Quervain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Al costat del canell del polze, sobre la prominència òssia del radi, i a la base del polze. Es pot estendre cap al dit o pujar per l'avantbraç, i augmenta en agafar, pessigar o girar el canell."
          }
        },
        {
          "@type": "Question",
          "name": "És el mateix que una tendinitis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No exactament. En la tenosinovitis de De Quervain el problema és a la beina que embolcalla els tendons i al túnel per on passen, que s'engruixeix i s'estreny, més que no pas al tendó en si."
          }
        },
        {
          "@type": "Question",
          "name": "Per què m'ha aparegut després de tenir un nadó?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perquè agafar el nadó amb els polzes separats i els canells inclinats, moltes vegades al dia, carrega molt els tendons del polze, i els canvis hormonals i la manca de descans d'aquesta etapa s'associen a un risc més alt. Sol evolucionar bé en adaptar la manera d'agafar-lo."
          }
        },
        {
          "@type": "Question",
          "name": "Com sé si és De Quervain o rizartrosi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La rizartrosi fa mal una mica més avall, a l'articulació de la base del polze, i és més pròpia de majors de 50 anys; la De Quervain fa mal al costat del canell i sol donar una prova de Finkelstein positiva. L'exploració permet diferenciar-les."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito una ecografia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Normalment no, perquè el diagnòstic és clínic. El seu metge pot valorar una ecografia si el dolor no evoluciona com s'espera o si els símptomes no són típics."
          }
        },
        {
          "@type": "Question",
          "name": "Puc continuar fent servir la mà?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Convé reduir durant un temps els gestos que més fan mal, com la pinça del polze o escórrer, però continuar movent els dits i el canell. El repòs absolut afavoreix la rigidesa."
          }
        },
        {
          "@type": "Question",
          "name": "L'ús del mòbil la pot causar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hi pot contribuir. Escriure amb el polze subjectant el telèfon amb una sola mà durant molta estona carrega els tendons afectats, sobretot si s'afegeix a altres tasques manuals repetides."
          }
        }
      ]
    }
