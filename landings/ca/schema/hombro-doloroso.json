    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/espatlla-dolorosa#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quant dura una espatlla congelada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La capsulitis adhesiva evoluciona per fases i pot durar d'un a tres anys. Un pla adaptat a cada fase ajuda a controlar el dolor i a recuperar la mobilitat."
          }
        },
        {
          "@type": "Question",
          "name": "He de deixar de moure l'espatlla si em fa mal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No és aconsellable immobilitzar-la. Es busca el moviment que l'espatlla tolera i s'amplia de manera progressiva."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito una ecografia o una ressonància?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sempre. Si ja disposa de proves, porti-les a la primera visita. Si l'exploració suggereix un trencament important, li recomanarem completar l'estudi amb una prova d'imatge."
          }
        },
        {
          "@type": "Question",
          "name": "El dolor d'espatlla pot venir del coll?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, en alguns casos. Per això s'explora també la columna cervical i la dorsal."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació té amb la diabetis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les persones amb diabetis tenen més risc de capsulitis adhesiva. Un bon control metabòlic forma part de l'abordatge."
          }
        }
      ]
