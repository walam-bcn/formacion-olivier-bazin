    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/cistitis-repeticio-bufeta-dolorosa#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Substitueix el tractament antibiòtic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Les infeccions urinàries s'han de tractar segons indiqui el seu metge. Treballem en coordinació amb el seu metge."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu homes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El nostre abordatge de la salut pèlvica s'adreça a dones."
          }
        },
        {
          "@type": "Question",
          "name": "Els cultius surten negatius però continuo amb molèsties, què pot ser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pot tractar-se d'una cistàlgia, un dolor de bufeta sense infecció. Els autors ho relacionen amb la sensibilitat de la regió del trígon i amb tensions mecàniques de l'entorn de la bufeta; el seu metge n'ha de descartar abans altres causes."
          }
        },
        {
          "@type": "Question",
          "name": "Per què empitjoren les meves molèsties abans de la regla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perquè la regió del trígon depèn de les hormones i és més sensible al voltant de l'ovulació i abans de la menstruació, quan a més la pelvis està més congestionada."
          }
        },
        {
          "@type": "Question",
          "name": "Per què tinc molèsties de bufeta després de les relacions o de fer esport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quan les anàlisis no mostren infecció, pot tractar-se d'una cistàlgia: una irritació mecànica de la base de la bufeta, el trígon, que es desencadena més fàcilment després de les relacions sexuals o d'activitats que sacsegen la pelvis, com córrer, saltar o muntar a cavall. Segons Olivier Bazin, respon especialment bé al tractament osteopàtic."
          }
        }
      ]
    }
