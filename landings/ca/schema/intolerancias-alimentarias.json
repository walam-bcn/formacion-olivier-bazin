    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/intolerancies-alimentaries#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És el mateix una intolerància que una al·lèrgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'al·lèrgia és una reacció del sistema immunitari que pot ser greu i requereix valoració per l'al·lergòleg. La intolerància és una dificultat digestiva que depèn de la quantitat."
          }
        },
        {
          "@type": "Question",
          "name": "He de deixar el gluten abans de venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Si sospita que el gluten li cau malament, demani abans al seu metge que descarti la celiaquia; les proves només són fiables si continua prenent-lo."
          }
        },
        {
          "@type": "Question",
          "name": "Hauré de retirar aquests aliments per sempre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la majoria dels casos, no. La retirada és temporal i la reintroducció guiada permet saber quant toleres."
          }
        },
        {
          "@type": "Question",
          "name": "I si a més tinc còlon irritable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És freqüent que coincideixin. Pot veure també còlon irritable i SIBO."
          }
        }
      ]
    }
