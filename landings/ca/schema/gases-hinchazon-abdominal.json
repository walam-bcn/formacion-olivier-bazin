    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/gasos-inflor-abdominal#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És normal inflar-se després de menjar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una mica sí. Quan la inflor és diària, molesta o el limita, val la pena revisar què la provoca i com respon el seu abdomen."
          }
        },
        {
          "@type": "Question",
          "name": "He de fer la dieta FODMAP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sempre. És una eina temporal que es planteja en alguns casos, sempre amb reintroducció progressiva per no empobrir l'alimentació ni la microbiota."
          }
        },
        {
          "@type": "Question",
          "name": "Què hi té a veure el diafragma amb la inflor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Molt. Si el diafragma baixa en excés després dels àpats, empeny el contingut abdominal cap endavant. Treballar la respiració i la mobilitat del diafragma ajuda a reduir aquesta distensió."
          }
        },
        {
          "@type": "Question",
          "name": "Els probiòtics serveixen per als gasos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. Abans d'afegir suplements revisem la seva alimentació i el seu ritme intestinal; si tenen sentit, li ho expliquem."
          }
        }
      ]
    }
