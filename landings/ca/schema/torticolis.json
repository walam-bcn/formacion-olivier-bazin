    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/torticoli#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quant dura una torticoli?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La majoria millora en pocs dies i es resol en una o dues setmanes. Mantenir el moviment i aplicar calor local ajuden a escurçar aquest temps."
          }
        },
        {
          "@type": "Question",
          "name": "És millor el fred o la calor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la torticoli sol alleujar més la calor local, perquè ajuda a relaxar la musculatura. La pot aplicar uns 15–20 minuts, diverses vegades al dia."
          }
        },
        {
          "@type": "Question",
          "name": "He d'immobilitzar el coll?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No és recomanable. Moure el coll amb suavitat, dins del que el dolor permeti, afavoreix una recuperació més ràpida."
          }
        },
        {
          "@type": "Question",
          "name": "Per què es repeteix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els episodis repetits solen relacionar-se amb postures mantingudes, manca de mobilitat dorsal, mal descans o estrès. Treballar aquests factors ajuda a espaiar-los."
          }
        }
      ]
    }
