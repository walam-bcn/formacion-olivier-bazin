      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/inflamacio-cronica-autoimmunes#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Substitueix el tractament del meu reumatòleg o dermatòleg?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'acompanyament és complementari i no modifica la medicació prescrita pel teu especialista."
          }
        },
        {
          "@type": "Question",
          "name": "Què és una alimentació antiinflamatòria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una alimentació basada en verdures, fruites, llegums, peix, oli d'oliva i fruita seca, amb pocs ultraprocessats. L'adaptem a la teva situació i a les teves digestions."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació hi ha entre l'intestí i la inflamació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La microbiota intestinal participa en la regulació del sistema immunitari. Per això cuidar la salut digestiva forma part de l'abordatge."
          }
        },
        {
          "@type": "Question",
          "name": "Puc venir durant un brot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En les fases de brot adaptem el pla i prioritzem el descans, el maneig del dolor i les mesures suaus."
          }
        }
      ]
