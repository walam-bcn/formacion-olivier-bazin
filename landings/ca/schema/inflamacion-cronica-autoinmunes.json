      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quant de temps triga a notar-se la millora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada persona, però els canvis en l'alimentació, el son i l'estrès se solen notar en poques setmanes. Revisem el pla amb vostè a cada visita."
          }
        },
        {
          "@type": "Question",
          "name": "Què és una alimentació antiinflamatòria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una alimentació basada en verdures, fruites, llegums, peix, oli d'oliva i fruita seca, amb pocs ultraprocessats. L'adaptem a la seva situació i a les seves digestions."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació hi ha entre l'intestí i la inflamació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La microbiota intestinal participa en la regulació del sistema immunitari. Per això cuidar la salut digestiva forma part de l'abordatge."
          }
        },
        {
          "@type": "Question",
          "name": "Puc venir durant un brot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En les fases de brot adaptem el pla i prioritzem el descans, el maneig del dolor i les mesures suaus."
          }
        }
      ]
