    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/cicatrius-adherencies#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan puc començar a tractar la cicatriu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El treball directe comença quan la ferida està ben tancada i sense signes d'infecció, habitualment a partir de les 4 a 6 setmanes. Abans es pot treballar la respiració i la mobilitat general."
          }
        },
        {
          "@type": "Question",
          "name": "Es pot tractar una cicatriu antiga?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Encara que la cicatriu tingui anys, el teixit conserva capacitat d'adaptació i la mobilització pot millorar-ne la flexibilitat i les molèsties associades."
          }
        },
        {
          "@type": "Question",
          "name": "Una cicatriu de cesària pot causar dolor d'esquena?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hi pot contribuir. La tensió de la cicatriu i de les fàscies abdominals influeix en la postura i en la mobilitat lumbar i pèlvica. Per això valorem la cicatriu juntament amb l'esquena i la pelvis."
          }
        },
        {
          "@type": "Question",
          "name": "El tractament és dolorós?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les tècniques són suaus i s'adapten a la sensibilitat de cada zona. Si nota una molèstia, se n'ajusta la intensitat. Trobarà més informació a les nostres pàgines de dolor postquirúrgic i fàscia."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del tipus de cicatriu, de la seva antiguitat i dels símptomes. En la primera visita valorem el seu cas i li proposem un pla amb revisions periòdiques."
          }
        }
      ]
    }
