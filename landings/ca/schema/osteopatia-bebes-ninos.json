    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/osteopatia-nadons-infants#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Des de quina edat es pot tractar un nadó?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Des de les primeres setmanes de vida, un cop el pediatre ha fet les revisions habituals. Les tècniques s'adapten a cada edat."
          }
        },
        {
          "@type": "Question",
          "name": "És segura l'osteopatia en nadons?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "S'utilitzen tècniques molt suaus, sense manipulacions brusques, i es respecta en tot moment l'estat i el ritme del nadó. La valoració inicial permet identificar els signes que requereixen l'atenció del pediatre."
          }
        },
        {
          "@type": "Question",
          "name": "Pot ajudar en la plagiocefàlia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la plagiocefàlia postural, millorar la mobilitat del coll i canviar les postures de suport és clau. Com més aviat s'aborda, millor respon el crani, que en els primers mesos és molt modelable."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions solen ser necessàries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En els nadons solen bastar poques sessions, espaiades una o dues setmanes. Després de la primera valoració l'orientem segons l'evolució del seu fill."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera sessió?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els informes del pediatre i del part si en té, un bolquer de recanvi i el necessari per alimentar-lo. És preferible venir amb el nadó descansat i sense haver menjat just abans."
          }
        }
      ]
    }
