    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/sindrome-tunel-carpia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan cal operar el túnel carpià?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La cirurgia es valora sobretot quan hi ha pèrdua de força, atròfia del múscul de la base del polze o una afectació important del nervi a l'electromiograma, o si el tractament conservador no ha estat suficient."
          }
        },
        {
          "@type": "Question",
          "name": "Serveix la fèrula nocturna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Mantenir el canell en posició neutra durant la nit redueix la pressió sobre el nervi i sol alleujar el formigueig nocturn."
          }
        },
        {
          "@type": "Question",
          "name": "Pot tenir relació amb el coll?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El nervi medià s'origina a les arrels cervicals, i la tensió al coll o a l'espatlla pot sumar símptomes. Per això se'n valora tot el recorregut. Si també té dolor cervical, consulti cervicàlgia."
          }
        },
        {
          "@type": "Question",
          "name": "És freqüent en l'embaràs o la menopausa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Els canvis hormonals i la retenció de líquids l'afavoreixen. En l'embaràs sol millorar en les setmanes posteriors al part."
          }
        }
      ]
    }
