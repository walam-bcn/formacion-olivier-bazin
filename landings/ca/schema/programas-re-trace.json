    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/programes-re-trace#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quin programa RE:TRACE em convé?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de la seva disponibilitat i del seu lloc de residència. Si viu a Barcelona, el Premium és el format de referència; si no pot venir cada setmana, Immersive Weekends concentra la feina en tres caps de setmana; si busca una intervenció intensiva i individual, Private Experience; i si prefereix una experiència en grup reduït, Exclusive Retreats."
          }
        },
        {
          "@type": "Question",
          "name": "Les proves de laboratori hi estan incloses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Els programes inclouen la coordinació de l'avaluació, la revisió dels resultats i la seva integració en el seu pla. Els costos de laboratori, genètica, epigenètica, microbiota, proves d'imatge i altres exploracions externes es pressuposten i s'abonen per separat."
          }
        },
        {
          "@type": "Question",
          "name": "Com començo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Amb una primera visita de 60 minuts (90 €), en què valorem el seu cas i li recomanem el programa més adequat."
          }
        }
      ]
