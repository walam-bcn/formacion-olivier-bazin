    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/diarrea-cronica#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan es considera crònica una diarrea?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quan les deposicions toves o líquides es mantenen més de quatre setmanes. És important que el seu metge descarti abans una causa orgànica."
          }
        },
        {
          "@type": "Question",
          "name": "Pot ser una intolerància?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De vegades sí. La lactosa, la fructosa o alguns sucres fermentables poden provocar diarrea. L'ajudem a identificar-los sense fer dietes més restrictives del que cal."
          }
        },
        {
          "@type": "Question",
          "name": "L'estrès em pot provocar diarrea?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'estrès accelera el trànsit intestinal i augmenta la sensibilitat de l'intestí. Aprendre a regular aquesta resposta sol reduir la urgència."
          }
        },
        {
          "@type": "Question",
          "name": "Quant es triga a notar millora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. Moltes persones noten canvis en poques setmanes en ajustar l'alimentació i la gestió de l'estrès. A la primera visita li proposem un pla amb objectius clars."
          }
        }
      ]
    }
