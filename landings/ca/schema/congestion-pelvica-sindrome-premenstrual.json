    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/congestio-pelviana-sindrome-premenstrual#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La síndrome premenstrual és «normal»?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les petites molèsties abans de la regla són molt freqüents: segons Pennington, citat per Olivier Bazin, el 95 % de les dones les té en algun moment de la vida. Quan es repeteixen cada cicle i alteren la vostra vida diària, val la pena valorar-les."
          }
        },
        {
          "@type": "Question",
          "name": "Quan és millor demanar hora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segons l'experiència dels autors, just després de la regla i abans del dia 14, quan la pelvis està menys congestionada i els teixits responen millor."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions calen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Olivier Bazin proposa dues o tres sessions, separades per la durada d'un cicle. No és un problema que es resolgui en una sola visita."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em valoren el fetge i el ronyó si em fa mal la pelvis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perquè el drenatge venós de la pelvis hi passa: la vena ovàrica esquerra desemboca a la vena renal esquerra i la congestió del fetge frena el retorn per la vena cava. A més, el fetge degrada les hormones sexuals."
          }
        },
        {
          "@type": "Question",
          "name": "La valoració és interna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A WA LAM l'abordatge és sempre extern, sobre l'abdomen, la pelvis, l'esquena i el tòrax."
          }
        }
      ]
    }
