    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/intolerancia-lactosa#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "He de deixar tots els làctics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gairebé mai. La majoria de les persones toleren petites quantitats, sobretot repartides al llarg del dia i juntament amb altres aliments."
          }
        },
        {
          "@type": "Question",
          "name": "Com es diagnostica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Amb el test d'alè d'hidrogen, que li pot sol·licitar el seu metge. Si ja el té, el revisem junts per orientar l'alimentació."
          }
        },
        {
          "@type": "Question",
          "name": "Com m'asseguro de prendre prou calci?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Amb làctics sense lactosa o fermentats, begudes vegetals enriquides, llegums, fruits secs, sardines o verdures de fulla verda. Si li preocupa la seva massa òssia, vegi també osteoporosi."
          }
        },
        {
          "@type": "Question",
          "name": "Pot millorar amb el temps?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quan és secundària a una alteració intestinal, sol millorar quan l'intestí es recupera. En tots els casos, cuidar la microbiota ajuda a tolerar millor."
          }
        }
      ]
    }
