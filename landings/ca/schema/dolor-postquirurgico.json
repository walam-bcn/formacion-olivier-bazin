    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-postquirurgic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És normal tenir dolor mesos després d'una operació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És més freqüent del que es creu: entre el 10 % i el 50 % de les persones mantenen algun grau de dolor després de cirurgies habituals. Convé valorar-lo aviat per evitar que es cronifiqui."
          }
        },
        {
          "@type": "Question",
          "name": "Quan puc començar després de l'operació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del tipus d'intervenció i dels terminis que li indiqui el seu cirurgià. A la primera visita valorem en quina fase de la recuperació es troba."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em molesta la cicatriu al frec?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És freqüent quan s'han lesionat petits nervis de la pell durant la cirurgia. Aquesta hipersensibilitat (al·lodínia) sol millorar amb un treball progressiu sobre la cicatriu i la regulació del dolor."
          }
        },
        {
          "@type": "Question",
          "name": "Atenen el dolor després d'una cirurgia oncològica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, sempre amb l'autorització del seu metge. Trobarà més informació a dolor oncològic."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'informe quirúrgic i les proves o informes mèdics recents que tingui. Ens ajuden a conèixer bé el seu cas."
          }
        }
      ]
