      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan puc començar després de l'operació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de la intervenció i del que indiqui el teu cirurgià. El drenatge limfàtic sol poder iniciar-se les primeres setmanes; les tècniques sobre la cicatriu, quan aquesta s'ha tancat."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu cirurgies estètiques?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: liposucció, abdominoplàstia, lifting i altres cirurgies estètiques, amb drenatge limfàtic i tècniques manuals."
          }
        },
        {
          "@type": "Question",
          "name": "I després d'una cirurgia oncològica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, sempre amb autorització mèdica signada. Més informació a dolor oncològic."
          }
        }
      ]
