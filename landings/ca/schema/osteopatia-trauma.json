    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/osteopatia-trauma#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan puc anar a l'osteopatia després d'un accident?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un cop descartades a urgències o pel seu metge les lesions que requereixen atenció immediata, com fractures o lesions neurològiques. En la fase inicial s'utilitzen tècniques molt suaus, que s'adapten a mesura que el dolor disminueix."
          }
        },
        {
          "@type": "Question",
          "name": "Què pot fer l'osteopatia després d'una fuetada cervical?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Valorar el coll, la base del crani, la mandíbula, el tòrax i les zones per on es va transmetre l'impacte, i tractar amb tècniques suaus les que han perdut mobilitat, juntament amb exercicis progressius per fer a casa."
          }
        },
        {
          "@type": "Question",
          "name": "Pot el cos guardar memòria d'un trauma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segons Barral, el cos té una gran memòria, i els xocs físics o emocionals poden deixar empremtes que es manifesten temps després. La recerca mostra que el trauma influeix en la manera com es perceben les sensacions corporals i s'associa a més molèsties físiques persistents."
          }
        },
        {
          "@type": "Question",
          "name": "He de parlar del que em va passar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Pot compartir el que vulgui i quan vulgui. La sessió se centra en com se sent el seu cos avui i en les seves molèsties actuals."
          }
        },
        {
          "@type": "Question",
          "name": "Què passa si m'emociono durant la sessió?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És una reacció natural i s'acull amb respecte. Podem fer una pausa, canviar de tècnica o acabar la sessió; vostè decideix en tot moment."
          }
        }
      ]
    }
