    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/sol-pelvia-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "L'abordatge és intern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A WA LAM el treball és sempre extern: es valora i es tracta a través de l'abdomen, la pelvis, el sacre, el còccix, la columna i les cames."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em valoren l'esquena, el fetge o els peus si el problema és a la pelvis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perquè la pelvis forma part d'una cadena. El fetge i el ronyó esquerre influeixen en el seu drenatge, la columna en la seva innervació i els peus i les cames en l'equilibri de les seves pressions. És il·lusori tractar la pelvis només a la pelvis."
          }
        },
        {
          "@type": "Question",
          "name": "En quin moment del cicle és millor demanar hora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La setmana següent a la regla, quan la pelvis està menys congestionada i els teixits responen millor. En l'endometriosi es prefereix la meitat del cicle."
          }
        },
        {
          "@type": "Question",
          "name": "Fa mal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No hauria de fer-ho. Un dels principis és no provocar mai dolor: el treball és suau i es pot notar alguna tibantor o molèstia lleu, que sempre pot comentar per adaptar la sessió."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions solen caldre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del motiu. En els trastorns menstruals i en l'acompanyament de la fertilitat se solen proposar dues o tres sessions separades per un cicle. En la neuràlgia del pudend solen caldre més sessions de l'habitual."
          }
        },
        {
          "@type": "Question",
          "name": "Puc venir si estic embarassada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'embaràs no és una contraindicació, però exigeix un treball molt suau i sessions curtes. Se solen proposar revisions en moments clau, cap a les setmanes 12-14, 20, 28 i 32, i una sessió de preparació tres o quatre setmanes abans del part."
          }
        },
        {
          "@type": "Question",
          "name": "Quan puc venir després del part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'ideal és esperar que l'úter recuperi la seva mida, unes 6 a 8 setmanes, o el retorn de la regla. Un dolor intens de còccix o de pubis, una lumbàlgia incapacitant o una ciàtica justifiquen una consulta abans."
          }
        },
        {
          "@type": "Question",
          "name": "Porto un DIU, és un problema?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Portar un dispositiu intrauterí no impedeix la valoració ni el tractament osteopàtic extern."
          }
        },
        {
          "@type": "Question",
          "name": "He de fer exercicis de sòl pelvià?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: els exercicis guiats per una fisioterapeuta o una llevadora són molt recomanables, sobretot després d'un part, i donen millors resultats quan la pelvis ha recuperat la seva mobilitat."
          }
        },
        {
          "@type": "Question",
          "name": "Una cicatriu antiga pot influir en les meves molèsties pèlviques?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pot ser. Qualsevol cirurgia de l'abdomen o la pelvis, com una apendicectomia o una cesària, i també infeccions antigues sense cicatriu visible, poden deixar adherències que limiten la mobilitat dels òrgans."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito un diagnòstic mèdic abans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És recomanable, sobretot si les molèsties són recents o intenses, o si hi ha febre, sagnat o sang a l'orina. L'osteopatia s'ocupa dels trastorns funcionals i treballa en coordinació amb el seu metge."
          }
        },
        {
          "@type": "Question",
          "name": "Com demano cita per a una valoració de sòl pelvià?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Escrigui'ns per WhatsApp, expliqui'ns breument què nota i li proposem dia i hora per a la primera valoració, de 60 minuts, a Sarrià–Sant Gervasi."
          }
        }
      ]
    }
