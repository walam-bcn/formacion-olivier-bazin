    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/sol-pelvia-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Feu tractament intern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El nostre abordatge és sempre extern. Si necessita un tractament intracavitari, l'orientem cap a una fisioterapeuta especialitzada en sòl pelvià."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito un diagnòstic mèdic abans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És recomanable, sobretot si el dolor és recent, intens o va acompanyat de sagnat o febre."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu homes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No atenem el dolor pèlvic masculí. L'orientarem cap a un uròleg o una fisioterapeuta especialitzada."
          }
        },
        {
          "@type": "Question",
          "name": "Com demano cita per a una valoració de sòl pelvià?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Escrigui'ns per WhatsApp, expliqui'ns breument què nota i li proposem dia i hora per a la primera valoració, de 60 minuts, a Sarrià–Sant Gervasi."
          }
        }
      ]
