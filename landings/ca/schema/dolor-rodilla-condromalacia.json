    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-genoll-condromalacia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La condromalàcia és el mateix que l'artrosi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La condromalàcia afecta el cartílag de la ròtula i és freqüent en persones joves i actives. Si el seu cas correspon a un desgast articular, pot consultar la pàgina d'artrosi."
          }
        },
        {
          "@type": "Question",
          "name": "He de deixar de córrer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Normalment no cal deixar-ho del tot. S'ajusten el volum i la intensitat mentre s'enforteix la musculatura, i es planifica un retorn progressiu."
          }
        },
        {
          "@type": "Question",
          "name": "Per què es treballa el maluc si em fa mal el genoll?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La força del maluc influeix en com s'alinea el genoll en recolzar. Enfortir-lo redueix la càrrega sobre la ròtula."
          }
        },
        {
          "@type": "Question",
          "name": "Quant triga a millorar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. Amb un programa d'exercici constant se sol notar una millora progressiva al llarg de les primeres setmanes. A la primera visita es fixen objectius concrets."
          }
        },
        {
          "@type": "Question",
          "name": "Són útils les genolleres o les plantilles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En casos seleccionats poden alleujar el dolor a curt termini i facilitar l'exercici, que continua sent la base del tractament."
          }
        }
      ]
    }
