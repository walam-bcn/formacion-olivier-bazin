      "mainEntity": [
        {
          "@type": "Question",
          "name": "Em podeu ajudar amb l'acidesa o el reflux?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, com a complement del seguiment mèdic. Revisem l'alimentació, els horaris, l'estrès i altres factors que influeixen en el reflux, i proposem un pla nutricional i d'hàbits. Si hi ha dificultat per empassar, sagnat o pèrdua de pes, primer t'ha de valorar el teu metge."
          }
        },
        {
          "@type": "Question",
          "name": "Treballeu el còlon irritable i el SIBO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Valorem l'alimentació, l'estrès i la microbiota i, quan aporta informació, sol·licitem un estudi de microbiota. El pla combina pautes nutricionals, regulació de l'estrès i, si escau, acupuntura."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu la fibromiàlgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Combinem exercici adaptat, educació en dolor, regulació del son i de l'estrès, acupuntura i teràpia manual."
          }
        },
        {
          "@type": "Question",
          "name": "I l'hipotiroïdisme o la tiroïditis de Hashimoto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, com a complement del tractament endocrinològic. Treballem l'alimentació, la salut intestinal, el son i l'estrès, sense modificar la medicació prescrita."
          }
        },
        {
          "@type": "Question",
          "name": "El meu problema no apareix a la llista. Puc consultar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La llista recull les indicacions més freqüents. Escriu-nos per WhatsApp, explica'ns el teu cas i et direm si et podem ajudar o a quin especialista convé anar."
          }
        },
        {
          "@type": "Question",
          "name": "Aquesta consulta substitueix el meu metge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El diagnòstic i el tractament mèdic corresponen al teu metge. El nostre acompanyament és complementari."
          }
        }
      ]
