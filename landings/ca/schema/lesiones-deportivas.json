    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/lesions-esportives#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "He de deixar de córrer si em fa mal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sempre. En moltes lesions per sobreús es pot mantenir una activitat adaptada si el dolor és lleu i no empitjora l'endemà. L'orientem sobre quant i com entrenar en cada fase."
          }
        },
        {
          "@type": "Question",
          "name": "Quines lesions de corredor tracten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre d'altres, la tendinopatia rotuliana i aquil·liana, la síndrome femoropatel·lar, la cinta iliotibial, la periostitis tibial i la fasciïtis plantar. Pot consultar també la nostra pàgina de dolor de genoll."
          }
        },
        {
          "@type": "Question",
          "name": "Quan puc tornar a entrenar després d'un esquinç?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del grau. La tornada es decideix per criteris funcionals: mobilitat, força, equilibri i tolerància als salts i els canvis de direcció. Trobarà més informació a la nostra pàgina d'esquinços."
          }
        },
        {
          "@type": "Question",
          "name": "I si és un trencament fibril·lar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En els trencaments musculars es combina la protecció inicial amb la càrrega progressiva des de les primeres fases. Consulti també la nostra pàgina de contractures i estrips."
          }
        },
        {
          "@type": "Question",
          "name": "Atenen esportistes que no competeixen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Atenem persones de qualsevol nivell, des de qui comença a córrer fins a qui prepara una competició, i adaptem el pla als seus objectius."
          }
        }
      ]
    }
