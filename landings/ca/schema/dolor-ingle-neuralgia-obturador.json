    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-engonal-neuralgia-obturador#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Per què em fa mal el genoll si el problema és a la pelvis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El nervi obturador innerva la càpsula del genoll. Si s'irrita a la pelvis, per exemple pel veïnatge de l'ovari o de la bufeta, el dolor es pot sentir a la cara interna del genoll."
          }
        },
        {
          "@type": "Question",
          "name": "Una cirurgia pot causar dolor d'engonal mesos després?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Les cicatrius i adherències internes, o una cinta per a la incontinència mal situada, poden comprimir o fixar un nervi. Convé que el seu cirurgià ho valori."
          }
        },
        {
          "@type": "Question",
          "name": "El dolor d'engonal pot venir de l'ovari?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Els nervis de l'ovari comparteixen trajecte amb nervis que porten la sensibilitat de l'engonal i de la cuixa, per això un dolor ovàric s'hi pot sentir. Vegeu dolor ovàric."
          }
        },
        {
          "@type": "Question",
          "name": "I si estic embarassada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A l'embaràs, les punxades d'engonal en moure's solen ser degudes al lligament rodó, i el cap del nadó pot comprimir estructures al final de la gestació."
          }
        },
        {
          "@type": "Question",
          "name": "Té relació amb el nervi pudend?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Són nervis diferents: el pudend dona dolor al perineu i a la vulva, i els d'aquesta pàgina, a l'engonal i a la cuixa. Però comparteixen veïnatge a la pelvis i es poden afectar alhora. Vegeu neuràlgia del pudend."
          }
        }
      ]
    }
