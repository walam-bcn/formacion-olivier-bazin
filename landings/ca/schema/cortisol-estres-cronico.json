    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/cortisol-estres-cronic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Necessito una anàlisi de cortisol?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sempre. L'estrès crònic es reconeix sobretot per com se sent i com dorm. Si el seu metge sospita una malaltia endocrina, és ell qui indica les proves."
          }
        },
        {
          "@type": "Question",
          "name": "L'estrès em pot fer engreixar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pot afavorir el greix abdominal, el piquejar i el mal descans. Si és el seu cas, treballem l'estrès juntament amb la pèrdua de pes."
          }
        },
        {
          "@type": "Question",
          "name": "En què es diferencia de l'esgotament?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'estrès sostingut pot acabar en un esgotament físic i emocional. Com més aviat s'aborda, més fàcil és recuperar l'energia."
          }
        },
        {
          "@type": "Question",
          "name": "I si a més tinc ansietat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És freqüent que vagin junts. Pot llegir més sobre l'abordatge de l'estrès i l'ansietat."
          }
        }
      ]
    }
