    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dorsalgia-dolor-esquena-alta#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La postura és la causa del meu dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hi influeix, però no hi ha una postura perfecta. El que més ajuda és canviar de posició sovint, moure's i enfortir l'esquena alta."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació té la respiració amb el dolor dorsal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les costelles i la columna dorsal es mouen amb cada respiració. Una respiració superficial i tensa sobrecarrega la zona; recuperar una respiració àmplia ajuda a alliberar-la."
          }
        },
        {
          "@type": "Question",
          "name": "L'estrès pot causar dolor d'esquena alta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'estrès manté els músculs del coll i l'esquena alta en tensió. Si et sents desbordat, consulta també la nostra pàgina d'estrès i ansietat."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. A la primera visita valorem la teva situació i et proposem un pla amb objectius clars."
          }
        }
      ]
