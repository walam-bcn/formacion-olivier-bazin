    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/allergies-asma-infeccions#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Puc deixar la meva medicació per a l'asma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Mai no ha de deixar ni reduir els inhaladors ni altres tractaments sense indicació del seu metge. Treballem alhora la respiració, el son i la microbiota perquè es trobi millor."
          }
        },
        {
          "@type": "Question",
          "name": "Què hi té a veure la microbiota amb les al·lèrgies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La microbiota intestinal participa en l'educació del sistema immunitari. Cuidar-la amb l'alimentació forma part d'un abordatge global."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu persones amb infeccions d'orina de repetició?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En dones, pot veure també cistitis de repetició."
          }
        },
        {
          "@type": "Question",
          "name": "Quan és millor començar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Qualsevol moment és bo, però en les al·lèrgies estacionals convé començar unes setmanes abans de la temporada de pol·len."
          }
        }
      ]
