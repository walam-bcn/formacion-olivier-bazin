    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/ciatica#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quant triga a millorar la ciàtica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La majoria de les persones nota millora les primeres setmanes. El nervi necessita temps per calmar-se, per això avancem per fases i ajustem el pla segons la seva evolució."
          }
        },
        {
          "@type": "Question",
          "name": "És millor fer repòs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general, no. Mantenir-se actiu dins del que és tolerable afavoreix la recuperació més que el repòs prolongat al llit."
          }
        },
        {
          "@type": "Question",
          "name": "Puc venir si tinc una hèrnia discal diagnosticada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Porti les seves proves a la primera visita i les revisem juntament amb la seva història clínica i l'exploració."
          }
        },
        {
          "@type": "Question",
          "name": "La ciàtica sempre necessita cirurgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La majoria dels casos millora amb tractament conservador. La cirurgia es planteja davant un dèficit neurològic progressiu, una síndrome de cua de cavall o un dolor intens que no respon després de diverses setmanes."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. A la primera visita valorem la seva situació i li proposem un pla amb objectius clars i revisions periòdiques."
          }
        }
      ]
    }
