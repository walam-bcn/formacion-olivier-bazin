    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/incontinencia-urinaria-esforc#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Substitueix la fisioteràpia de sòl pelvià?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. L'entrenament del sòl pelvià és el tractament de primera elecció. Treballem en coordinació amb la seva fisioterapeuta i, si ho necessita, l'adrecem a una fisioterapeuta especialitzada."
          }
        },
        {
          "@type": "Question",
          "name": "Feu tractament intern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El nostre abordatge és sempre extern."
          }
        },
        {
          "@type": "Question",
          "name": "Per què tinc més pèrdues abans de la regla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perquè abans de la menstruació l'úter pesa més, canvia d'orientació i la uretra tanca pitjor; el trígon, la vagina i el sòl pelvià depenen de les hormones. Les pèrdues solen millorar després de la regla."
          }
        },
        {
          "@type": "Question",
          "name": "Vaig tenir pèrdues a l'embaràs que van desaparèixer, m'he de preocupar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No és motiu d'alarma, però sí de prevenció: una incontinència durant l'embaràs duplica el risc de tenir-la quinze anys després. Tenir cura del sòl pelvià després del part és una bona inversió."
          }
        },
        {
          "@type": "Question",
          "name": "Tinc un cistocele però no tinc pèrdues, és normal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Hi ha dones perfectament continents amb un descens important de la bufeta: ptosi i incontinència no són sinònims."
          }
        }
      ]
    }
