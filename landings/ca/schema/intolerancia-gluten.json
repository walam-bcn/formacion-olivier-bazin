    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/intolerancia-gluten#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Puc deixar el gluten abans de fer-me les proves?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És millor no fer-ho. La serologia i la biòpsia de celiaquia necessiten que continuïs menjant gluten per ser fiables. Primer les proves, després els canvis."
          }
        },
        {
          "@type": "Question",
          "name": "Hauré d'eliminar el gluten per sempre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No necessàriament. Moltes persones toleren una certa quantitat. La reintroducció guiada serveix precisament per trobar el seu marge."
          }
        },
        {
          "@type": "Question",
          "name": "I si no és el gluten, sinó altres components del blat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De vegades els símptomes es deuen als fructans del blat, un tipus de FODMAP. Ho valorem juntament amb altres intoleràncies alimentàries."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació té amb el còlon irritable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Comparteixen símptomes i sovint coincideixen. Si és el seu cas, l'abordatge del còlon irritable s'integra en el mateix pla."
          }
        }
      ]
    }
