      "mainEntity": [
        {
          "@type": "Question",
          "name": "Puc fer exercici si tinc artrosi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. L'exercici adaptat és un dels tractaments més eficaços en l'artrosi. L'ajustem a la teva articulació, al teu nivell i al teu dolor."
          }
        },
        {
          "@type": "Question",
          "name": "Ateneu el dolor esportiu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: tendinopaties, sobrecàrregues i dolor muscular relacionat amb l'esport, amb un pla de retorn progressiu a l'activitat."
          }
        },
        {
          "@type": "Question",
          "name": "I la fibromiàlgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, amb un abordatge que combina activitat física gradual, regulació del son i de l'estrès, tècniques manuals i nutrició antiinflamatòria."
          }
        }
      ]
