    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-musculoesqueletic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quina diferència hi ha entre una contractura i un trencament fibril·lar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la contractura el múscul està tens i adolorit, però sense trencament de fibres, i sol millorar en pocs dies. En el trencament fibril·lar hi ha un dany parcial de les fibres: el dolor és sobtat i intens, pot aparèixer un hematoma i la recuperació requereix diverses setmanes."
          }
        },
        {
          "@type": "Question",
          "name": "Fred o calor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En les primeres 48–72 hores després d'una lesió aguda, fred local. En les contractures i en la fase de recuperació, la calor ajuda a relaxar la musculatura."
          }
        },
        {
          "@type": "Question",
          "name": "Quan puc tornar a fer esport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quan la zona ja no fa mal en les activitats diàries i s'han recuperat la força i la mobilitat. La tornada ha de ser progressiva, i els terminis depenen del tipus i del grau de la lesió."
          }
        },
        {
          "@type": "Question",
          "name": "Quan he de consultar per un dolor muscular?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si el dolor dura més de dues o tres setmanes, es repeteix o li impedeix fer la seva activitat habitual. Davant d'una deformitat, la impossibilitat de recolzar o una pèrdua de força, vagi a urgències."
          }
        },
        {
          "@type": "Question",
          "name": "En què es diferencia del dolor articular i miofascial?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aquesta pàgina se centra en les lesions musculars i de lligaments, agudes o per sobrecàrrega. El dolor articular i miofascial inclou l'artrosi, les tendinopaties i els punts gallet."
          }
        }
      ]
    }
