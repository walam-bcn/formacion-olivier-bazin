    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-persistent-cronic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Per què em continua fent mal si la lesió ja s'ha curat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perquè, quan el dolor es manté, el sistema nerviós es pot sensibilitzar i continuar generant dolor encara que els teixits s'hagin recuperat. El dolor és real, i es pot treballar sobre els mecanismes que el mantenen."
          }
        },
        {
          "@type": "Question",
          "name": "Què és el programa MBSR?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És un programa de reducció de l'estrès basat en mindfulness, de 8 setmanes, creat per Jon Kabat-Zinn a la Universitat de Massachusetts per a persones amb dolor crònic. Ensenya a relacionar-se d'una altra manera amb el dolor i a regular la resposta d'estrès."
          }
        },
        {
          "@type": "Question",
          "name": "És segur fer exercici amb dolor crònic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, sempre que s'adapti i s'augmenti de manera progressiva. Moure's amb una pauta adequada és una de les mesures més eficaces i no suposa danyar els teixits."
          }
        },
        {
          "@type": "Question",
          "name": "Quant de temps triga a notar-se la millora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. Moltes persones noten canvis en el son, l'energia o la tolerància a l'activitat les primeres setmanes; la reducció del dolor sol ser progressiva."
          }
        },
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els seus informes mèdics, les proves realitzades i la llista de la medicació que pren. Si li és possible, unes notes sobre com varia el seu dolor al llarg de la setmana."
          }
        }
      ]
    }
