    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/dolor-persistent-cronic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quines disciplines intervenen en l'abordatge del dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'osteopatia i l'acupuntura, integrades en un pla individual. Quan cal un programa de fisioteràpia, fem la derivació a un fisioterapeuta col·legiat."
          }
        },
        {
          "@type": "Question",
          "name": "Què es considera dolor crònic o persistent?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general, el dolor que dura més de tres mesos o que persisteix més enllà del temps habitual de curació d'un teixit. Pot ser continu o aparèixer per episodis."
          }
        },
        {
          "@type": "Question",
          "name": "Les meves proves estan bé, però em continua fent mal. És normal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És més freqüent del que sembla. Les proves d'imatge mostren estructures, però no mesuren la sensibilitat del sistema nerviós. Que no aparegui una lesió no vol dir que el teu dolor no sigui real."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito un informe mèdic per venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No és imprescindible, però si tens proves o informes, porta'ls a la primera consulta. Ens ajuden a valorar millor el teu cas."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. Després de la primera valoració et proposem un pla amb objectius i moments de revisió, perquè sàpigues en tot moment com avancem."
          }
        },
        {
          "@type": "Question",
          "name": "Qui m'atendrà?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "T'atén sempre Rosa María Rodríguez Valls, osteòpata D.O., des de la primera valoració fins al seguiment."
          }
        }
      ]
