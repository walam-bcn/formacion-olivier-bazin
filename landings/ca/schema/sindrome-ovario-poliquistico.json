    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/sindrome-ovari-poliquistic#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "He de perdre pes per millorar la SOP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sempre. L'exercici i l'alimentació milloren la sensibilitat a la insulina també sense pèrdua de pes. Si hi ha sobrepès, una reducció moderada ja pot ajudar."
          }
        },
        {
          "@type": "Question",
          "name": "Quin tipus d'alimentació recomaneu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una alimentació basada en aliments frescos, amb proteïna i fibra a cada àpat i pocs sucres i ultraprocessats. L'adaptem als seus gustos i al seu ritme de vida."
          }
        },
        {
          "@type": "Question",
          "name": "Quant de temps triga a notar-se la millora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'energia i les digestions solen millorar en poques setmanes. Els canvis en el cicle i en la pell necessiten una mica més de temps, normalment uns mesos de constància."
          }
        },
        {
          "@type": "Question",
          "name": "I si busco un embaràs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "També l'acompanyem en aquesta etapa. Pot conèixer el nostre acompanyament a la fertilitat."
          }
        }
      ]
    }
