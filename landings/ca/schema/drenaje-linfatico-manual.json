      "mainEntity": [
        {
          "@type": "Question",
          "name": "És el mateix que la pressoteràpia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La pressoteràpia aplica compressió amb un aparell pneumàtic; el drenatge limfàtic manual és una tècnica feta amb les mans."
          }
        },
        {
          "@type": "Question",
          "name": "Atenteu pacients amb càncer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, però sempre amb l'autorització del seu metge."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del motiu. Si té limfedema diagnosticat, el nombre de sessions s'ajusta al que indiqui el seu metge especialista."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sessió d'1 hora costa 70 € i el bo de 10 sessions més 1 de regal, 700 €."
