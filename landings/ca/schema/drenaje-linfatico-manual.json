    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/drenatge-limfatic-manual#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Fa mal el drenatge limfàtic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La pressió és molt suau, perquè els vasos limfàtics són just sota la pell. Si una zona està sensible, com en el lipedema o després d'una operació, la tècnica s'adapta encara més."
          }
        },
        {
          "@type": "Question",
          "name": "És el mateix que la pressoteràpia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La pressoteràpia aplica compressió amb un aparell pneumàtic; el drenatge limfàtic manual es fa amb les mans i permet adaptar la direcció i la pressió a cada zona i a cada persona."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per a unes cames cansades pot ser suficient una sessió setmanal o quinzenal a les èpoques de més calor. En el postoperatori, el limfedema o el lipedema solen caldre diverses sessions seguides durant unes setmanes. L'orientem segons el seu cas."
          }
        },
        {
          "@type": "Question",
          "name": "Quan puc començar després d'una operació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de la intervenció i de les indicacions del seu cirurgià. Després d'una cirurgia estètica se sol començar els primers dies; després d'una cirurgia traumatològica, quan la ferida ho permet. Consulti la nostra pàgina de drenatge postoperatori."
          }
        },
        {
          "@type": "Question",
          "name": "Quant costa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sessió de 60 minuts costa 70 €. Disposa d'un bo de 10 sessions + 1 de regal: escrigui'ns per WhatsApp."
          }
        }
      ]
    }
