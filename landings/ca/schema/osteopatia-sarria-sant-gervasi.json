    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/osteopatia-sarria-sant-gervasi#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del seu cas. En general revisem l'evolució després de dues o tres sessions i decidim junts si té sentit continuar."
          }
        },
        {
          "@type": "Question",
          "name": "Fa mal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La majoria de tècniques són suaus. Algunes poden produir una molèstia lleu o sensació de cansament durant un o dos dies."
          }
        },
        {
          "@type": "Question",
          "name": "Quina diferència hi ha entre l'osteopatia i la fisioteràpia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Totes dues són complementàries. L'osteopatia se centra en la valoració i el tractament manual global; la fisioteràpia posa més pes en l'exercici, la recuperació funcional i la readaptació."
          }
        },
        {
          "@type": "Question",
          "name": "Puc venir si estic embarassada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Atenem dones embarassades i adaptem el tractament a cada etapa. Més informació a osteopatia en l'embaràs i el postpart."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito prescripció mèdica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No és necessària. Si durant la valoració detectem alguna cosa que requereix estudi mèdic, li ho direm."
          }
        }
      ]
    }
