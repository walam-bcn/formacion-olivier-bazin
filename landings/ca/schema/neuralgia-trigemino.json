    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/neuralgia-trigemin#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Com és la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dura 60 minuts. Revisem la teva història, com és el teu dolor, els punts gallet, la mandíbula, el coll, el son i l'estrès, i et proposem un pla adaptat a tu."
          }
        },
        {
          "@type": "Question",
          "name": "L'osteopatia és adequada si tinc punts gallet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, amb tècniques suaus i adaptades. Evitem estimular els punts gallet i treballem la regió cervical, la mandíbula i el crani a un ritme que respecta el teu dolor."
          }
        },
        {
          "@type": "Question",
          "name": "Pot ajudar l'acupuntura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'acupuntura s'ha associat amb una millora del dolor en la neuràlgia del trigemin. La fem servir amb punts a distància quan la cara està molt sensible."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació té amb el bruxisme i la mandíbula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No són el mateix, però la tensió mandibular i el bruxisme poden sumar dolor i sensibilitat a la cara. Per això valorem també l'articulació temporomandibular."
          }
        },
        {
          "@type": "Question",
          "name": "Quan he de consultar amb urgència?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si el dolor facial és nou i tens més de 50 anys, o apareixen pèrdua de sensibilitat, debilitat a la cara, alteracions de la visió o febre, consulta el teu metge sense demora."
          }
        }
      ]
    }
