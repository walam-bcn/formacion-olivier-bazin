    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/neuralgia-trigemin#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "És el mateix que un mal de queixal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Es pot confondre perquè el dolor es nota sovint a les dents o la mandíbula, però és un dolor d'origen nerviós, en descàrregues breus i desencadenat per estímuls lleus. Per això és important el diagnòstic neurològic."
          }
        },
        {
          "@type": "Question",
          "name": "La teràpia manual és adequada si tinc punts gallet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, amb tècniques suaus i adaptades. S'evita estimular els punts gallet i es treballa la regió cervical, la mandíbula i el crani a un ritme que respecta el seu dolor."
          }
        },
        {
          "@type": "Question",
          "name": "Hi pot ajudar l'acupuntura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'acupuntura s'ha associat amb una millora del dolor en la neuràlgia del trigemin primària. Quan la cara està molt sensible, s'utilitzen punts a distància."
          }
        },
        {
          "@type": "Question",
          "name": "Quina relació té amb el bruxisme i la mandíbula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No són el mateix, però la tensió mandibular i el bruxisme poden sumar dolor i sensibilitat a la cara. Per això es valora també l'articulació temporomandibular."
          }
        },
        {
          "@type": "Question",
          "name": "La neuràlgia del trigemin pot desaparèixer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És freqüent que alterni períodes de crisi amb fases de remissió de setmanes o mesos. El tractament busca controlar les crisis i millorar la qualitat de vida."
          }
        }
      ]
    }
