    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/drenatge-limfatic-postoperatori#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan puc començar després de l'operació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de la cirurgia i del que indiqui el teu cirurgià. Escriu-nos amb aquesta informació i t'orientem abans de reservar."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions solen caldre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Varia segons la intervenció, l'evolució i les indicacions del teu cirurgià. Ho revisem sessió a sessió. La sessió d'1 hora costa 70 € i el bo de 10 sessions més 1 de regal, 700 €."
          }
        },
        {
          "@type": "Question",
          "name": "És el mateix que un massatge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El drenatge limfàtic manual és una tècnica específica, molt suau i lenta, diferent del massatge. Per això té la seva pròpia pàgina."
          }
        },
        {
          "@type": "Question",
          "name": "He de portar la faixa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segueix les indicacions del teu cirurgià sobre peces de compressió. Normalment te la treus durant la sessió i te la tornes a posar en acabar."
          }
        }
      ]
    }
