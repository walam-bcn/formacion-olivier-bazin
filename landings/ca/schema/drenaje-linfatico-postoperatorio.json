    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/drenatge-limfatic-postoperatori#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan puc començar després de l'operació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de la cirurgia i del que indiqui el seu cirurgià. Escrigui'ns amb aquesta informació i l'orientem abans de reservar."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions solen caldre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Varia segons la intervenció, l'evolució i les indicacions del seu cirurgià. Ho revisem sessió a sessió. La sessió d'1 hora costa 70 € i el bo de 10 sessions més 1 de regal, 700 €."
          }
        },
        {
          "@type": "Question",
          "name": "És el mateix que un massatge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El drenatge limfàtic manual és una tècnica específica, molt suau i lenta, diferent del massatge. Per això té la seva pròpia pàgina."
          }
        },
        {
          "@type": "Question",
          "name": "He de portar la faixa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segueixi les indicacions del seu cirurgià sobre peces de compressió. Normalment se la treu durant la sessió i se la torna a posar en acabar."
          }
        }
      ]
    }
