    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/postpart-recuperacio#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quan puc començar l'osteopatia després del part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els autors aconsellen esperar que l'úter involucioni (6–8 setmanes) i, si és possible, la tornada de la regla. Un part difícil amb dolor de còccix, de pubis, lumbàlgia o ciàtica pot justificar una consulta abans."
          }
        },
        {
          "@type": "Question",
          "name": "És normal tenir pèrdues d'orina després del part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És freqüent: més de la meitat de les primípares en tenen i sovint milloren soles. Però freqüent no vol dir que s'hi hagi de resignar; si persisteixen, convé valorar-les."
          }
        },
        {
          "@type": "Question",
          "name": "Em van fer una cesària, també he de revisar el perineu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La cesària protegeix més el suport de la uretra els primers mesos, però l'embaràs en si ja exigeix molt el sòl pelvià. A més, la cicatriu abdominal pot crear adherències que convé valorar."
          }
        },
        {
          "@type": "Question",
          "name": "El baby blues té a veure amb el cos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És degut sobretot als canvis hormonals i emocionals del postpart. Els autors pensen, per la seva experiència, que el descens dels ronyons després del part hi podria participar, i el llibre assenyala que el baby blues agreuja els problemes d'incontinència."
          }
        },
        {
          "@type": "Question",
          "name": "Necessito reeducació perineal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'autor la recomana quan el to del perineu ha disminuït després del part, amb fisioterapeuta o llevadora, idealment després de resoldre els problemes mecànics de la pelvis."
          }
        }
      ]
    }
