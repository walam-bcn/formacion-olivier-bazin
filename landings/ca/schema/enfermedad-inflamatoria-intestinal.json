      "mainEntity": [
        {
          "@type": "Question",
          "name": "Què he de portar a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els seus informes recents, les analítiques i la llista del que pren. Amb això i la seva història dissenyem un pla centrat en la seva energia, la seva alimentació i la seva qualitat de vida."
          }
        },
        {
          "@type": "Question",
          "name": "Hi ha una dieta per al Crohn o la colitis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No hi ha una dieta única. Ajustem l'alimentació a la seva fase, els seus símptomes i les seves toleràncies per menjar amb més seguretat i varietat."
          }
        },
        {
          "@type": "Question",
          "name": "Em podeu ajudar amb la fatiga?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Revisem el son, l'activitat, l'estrès i l'alimentació, i proposem moviment suau adaptat a la seva energia."
          }
        },
        {
          "@type": "Question",
          "name": "Puc venir durant un brot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Durant un brot, la prioritat és el seu equip de digestiu. Li podem oferir un acompanyament amb pautes suaus i reprendre el pla quan estigui més estable."
          }
        }
      ]
