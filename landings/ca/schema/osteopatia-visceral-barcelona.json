    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/osteopatia-visceral-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Fa mal l'osteopatia visceral?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No acostuma a fer mal. Les tècniques són suaus i s'adapten a la sensibilitat de cada zona. Algunes àrees es poden notar més sensibles durant la sessió."
          }
        },
        {
          "@type": "Question",
          "name": "Qui va ser Jean-Pierre Barral?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "És un osteòpata i fisioterapeuta francès, creador de la manipulació visceral. Va desenvolupar el mètode a partir de la seva feina en un hospital de Grenoble i dels seus estudis d'anatomia; avui s'ensenya a tot el món a través del Barral Institute."
          }
        },
        {
          "@type": "Question",
          "name": "Pot ajudar amb el còlon irritable o el restrenyiment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Els estudis en la síndrome de l'intestí irritable mostren millores del dolor i la distensió abdominal. Ho integrem amb l'alimentació i la salut digestiva, segons el seu cas."
          }
        },
        {
          "@type": "Question",
          "name": "Quantes sessions necessitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn del motiu de consulta i de la seva evolució. Després de la primera sessió l'orientem sobre la freqüència; sovint s'espaien una o dues setmanes per observar la resposta del cos."
          }
        },
        {
          "@type": "Question",
          "name": "Quina diferència hi ha amb la manipulació neural?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'osteopatia visceral se centra en els òrgans, les seves fàscies i els seus lligaments; la manipulació neural i neurovisceral, en els nervis i les meninges. Totes dues formen part del mètode Barral i sovint es combinen."
          }
        }
      ]
    }
  ]
