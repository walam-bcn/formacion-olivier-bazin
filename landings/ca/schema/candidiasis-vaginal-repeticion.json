    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/candidiasi-vaginal-repeticio#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quant de temps triga a notar-se la millora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depèn de cada cas. Els canvis d'hàbits i d'alimentació es valoren al llarg d'uns mesos, observant si els episodis s'espaien i són més lleus."
          }
        },
        {
          "@type": "Question",
          "name": "L'exploració és interna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Treballem sempre amb un abordatge extern i atenem únicament dones."
          }
        },
        {
          "@type": "Question",
          "name": "Hi influeix l'alimentació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'alimentació influeix en la microbiota i en el control de la glucosa. Revisem els seus hàbits per reduir l'excés de sucres i ultraprocessats i afavorir una microbiota diversa."
          }
        },
        {
          "@type": "Question",
          "name": "Quins hàbits poden ajudar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Evitar les dutxes vaginals i els productes perfumats, fer servir roba interior transpirable i canviar-se aviat la roba humida després de nedar o fer esport."
          }
        }
      ]
    }
