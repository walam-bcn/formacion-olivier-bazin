    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/candidiasi-vaginal-repeticio#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Substitueix el tractament antifúngic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El tractament el pauta el teu ginecòleg. L'acompanyament és complementari i se centra en els factors que afavoreixen les recaigudes."
          }
        },
        {
          "@type": "Question",
          "name": "L'exploració és interna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Treballem sempre amb un abordatge extern i atenem únicament dones."
          }
        },
        {
          "@type": "Question",
          "name": "Hi influeix l'alimentació?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'alimentació influeix en la microbiota i en el control de la glucosa. Revisem els teus hàbits per reduir l'excés de sucres i ultraprocessats i afavorir una microbiota diversa."
          }
        },
        {
          "@type": "Question",
          "name": "Quins hàbits poden ajudar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Evitar les dutxes vaginals i els productes perfumats, fer servir roba interior transpirable i canviar-se aviat la roba humida després de nedar o fer esport."
          }
        }
      ]
    }
