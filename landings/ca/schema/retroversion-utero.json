    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/ca/tractaments-sarria-sant-gervasi-barcelona/retroversio-uter#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Tenir l'úter en retroversió és una malaltia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. És una variant freqüent i la majoria de vegades no dona símptomes. Segons els autors, només causa problemes quan l'úter, a més, ha perdut mobilitat."
          }
        },
        {
          "@type": "Question",
          "name": "L'osteopatia pot canviar la posició de l'úter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'objectiu no és corregir la posició, sinó retornar mobilitat a l'úter i equilibrar-ne els lligaments, que és el que, segons el llibre, alleuja els símptomes."
          }
        },
        {
          "@type": "Question",
          "name": "La retroversió impedeix quedar-se embarassada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En general, no. El llibre recull que alguns autors la relacionen amb infertilitat i avortaments de repetició, però en la majoria de les dones és asimptomàtica."
          }
        },
        {
          "@type": "Question",
          "name": "Per què em fa mal en les relacions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En una retroversió important amb poca mobilitat, el coll de l'úter rep cops durant la penetració profunda i el dolor pot durar hores. Llegiu-ne més a la pàgina de dispareunia."
          }
        },
        {
          "@type": "Question",
          "name": "Pot aparèixer una retroversió després d'un part?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, és freqüent: els lligaments distesos triguen a recuperar la tensió i, en parts difícils, es poden lesionar."
          }
        }
      ]
    }
