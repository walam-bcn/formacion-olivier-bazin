      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo puedo empezar después de la operación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la cirugía y de lo que indique tu cirujano. Escríbenos con esa información y te orientamos antes de reservar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones suelen hacer falta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Varía según la intervención, la evolución y las indicaciones de tu cirujano. Lo revisamos sesión a sesión. La sesión de 1 hora cuesta 70 € y el bono de 10 sesiones más 1 de regalo, 700 €."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es lo mismo que un masaje?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El drenaje linfático manual es una técnica específica, muy suave y lenta, distinta del masaje. Por eso tiene su propia página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tengo que llevar la faja?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sigue las indicaciones de tu cirujano sobre prendas de compresión. Normalmente la retiras durante la sesión y te la vuelves a poner al terminar."
          }
        }
      ]
