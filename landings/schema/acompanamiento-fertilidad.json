      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Esto sustituye a un tratamiento de fertilidad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Es un acompañamiento complementario. Las decisiones diagnósticas y de tratamiento corresponden a su ginecóloga o a su clínica de reproducción."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué aporta la acupuntura durante un tratamiento de fertilidad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puede ayudarle a gestionar el estrés y a cuidar su bienestar durante el proceso, como complemento del seguimiento de su clínica de reproducción."
          }
        },
        {
          "@type": "Question",
          "name": "¿Podemos venir en pareja?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Atendemos tanto de forma individual como en pareja."
