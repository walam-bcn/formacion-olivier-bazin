      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Sustituye a la fisioterapia de suelo pélvico o a la cirugía?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El entrenamiento del suelo pélvico es el tratamiento conservador de referencia y, en los casos que lo requieren, la ginecóloga valora otras opciones. Nuestro abordaje es complementario."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hacéis tratamiento interno?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Nuestro abordaje es siempre externo."
          }
        }
