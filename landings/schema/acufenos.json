    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/acufenos#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Los acúfenos pueden estar relacionados con la mandíbula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En el acúfeno somatosensorial, la tensión de la ATM y de los músculos de la masticación puede modificar el sonido. Puede consultar también nuestra página de bruxismo y ATM."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y con el cuello?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "También. Las contracturas y la rigidez cervical, o un latigazo previo, pueden influir en la intensidad del acúfeno. Encontrará más información en nuestra página de cervicalgia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué lo oigo más por la noche?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En silencio, el cerebro presta más atención al acúfeno. El cansancio y el estrés también aumentan su percepción. Un sonido de fondo suave y una rutina de sueño tranquila ayudan."
          }
        },
        {
          "@type": "Question",
          "name": "¿Desaparecen los acúfenos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Algunos remiten, sobre todo si se trata su causa. En otros casos el sonido persiste, pero su intensidad y la molestia que produce pueden disminuir de forma notable con el tratamiento adecuado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito una audiometría antes de la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es recomendable que el acúfeno haya sido valorado por un otorrinolaringólogo. Si ya tiene una audiometría u otras pruebas, tráigalas a la primera visita."
          }
        }
      ]
    }
