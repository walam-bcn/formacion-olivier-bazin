    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/esguinces#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo puedo empezar la recuperación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una vez descartada una fractura, desde los primeros días. La movilización temprana y progresiva favorece una mejor evolución."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es la propiocepción?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es la capacidad del sistema nervioso para percibir la posición de una articulación. Tras un esguince se altera, y entrenarla ayuda a prevenir nuevas torceduras."
          }
        },
        {
          "@type": "Question",
          "name": "¿También se tratan los esguinces de rodilla y de muñeca?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, en la fase de recuperación. Si se sospecha una rotura de los ligamentos cruzados o una inestabilidad importante, se requiere antes una valoración traumatológica. Si le preocupa la rodilla, consulte también dolor de rodilla."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo puedo volver a hacer deporte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cuando haya recuperado la movilidad, la fuerza y el equilibrio, y tolere sin dolor los gestos de su deporte. La vuelta se planifica por etapas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es un esguince mal curado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el que deja dolor, hinchazón o sensación de inestabilidad semanas después de la lesión. Suele mejorar con un programa específico de fuerza y propiocepción."
          }
        }
      ]
    }
