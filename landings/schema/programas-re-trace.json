    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/metodo-integrativo-sarri%C3%A0-sant-gervasi-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué programa re:trace me conviene?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de su disponibilidad y de su lugar de residencia. Si vive en Barcelona, el Premium es el formato de referencia; si no puede acudir cada semana, Immersive Weekends concentra el trabajo en tres fines de semana; si busca una intervención intensiva e individual, Private Experience; y si prefiere una experiencia en grupo reducido, Exclusive Retreats."
          }
        },
        {
          "@type": "Question",
          "name": "¿Están incluidas las pruebas de laboratorio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Los programas incluyen la coordinación de la evaluación, la revisión de los resultados y su integración en su plan. Los costes de laboratorio, genética, epigenética, microbiota, pruebas de imagen y otras exploraciones externas se presupuestan y abonan por separado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo empiezo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Con una primera visita de 60 minutos (90 €), en la que valoramos su caso y le recomendamos el programa más adecuado."
          }
        }
      ]
    }
