    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/artrosis#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Puedo hacer ejercicio si tengo artrosis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El ejercicio adaptado es uno de los pilares del tratamiento. Se ajusta a la articulación afectada, a su condición física y al dolor de cada momento."
          }
        },
        {
          "@type": "Question",
          "name": "¿Perder peso alivia el dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la artrosis de rodilla y de cadera, reducir el exceso de peso disminuye la carga sobre la articulación y suele mejorar el dolor y la función."
          }
        },
        {
          "@type": "Question",
          "name": "¿La artrosis de manos y de columna también se puede tratar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Cada localización requiere un plan propio. Si el dolor es sobre todo lumbar, puede consultar también la página de lumbalgia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tiene sentido si ya me han propuesto una prótesis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Llegar a la cirugía con más fuerza y movilidad favorece la recuperación posterior."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es normal que me duela más con el frío?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muchas personas notan más rigidez con el frío y la humedad. El calor local y mantener la actividad suelen aliviarla."
          }
        }
      ]
    }
