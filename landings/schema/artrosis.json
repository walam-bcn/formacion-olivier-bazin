    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/artrosis#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Puedo hacer ejercicio si tengo artrosis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El ejercicio adaptado es uno de los pilares del tratamiento. Lo ajustamos a tu articulación, tu nivel y tu dolor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Perder peso ayuda de verdad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la artrosis de rodilla y cadera, reducir el exceso de peso disminuye la carga sobre la articulación y suele aliviar el dolor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis la artrosis de manos y de columna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. También la de manos y la de columna, con un plan adaptado a cada zona. Si el dolor es sobre todo lumbar, consulta también lumbalgia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es útil si ya me han propuesto una prótesis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puede ayudarte a llegar a la cirugía con más fuerza y movilidad, como complemento del seguimiento de tu traumatólogo."
          }
        }
      ]
    }
