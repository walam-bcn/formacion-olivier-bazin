    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/osteoporosis#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Puedo hacer ejercicio de fuerza si tengo osteoporosis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Bien adaptado y progresivo, es una de las mejores herramientas para cuidar el hueso y el músculo. Ajustamos la carga y los movimientos a tu densitometría y a tu situación."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo tarda en notarse la mejoría?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La fuerza y el equilibrio mejoran en pocas semanas de ejercicio regular. Los cambios en el hueso son más lentos y se valoran con la densitometría al cabo de uno o dos años."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué relación tiene con la menopausia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El descenso de estrógenos acelera la pérdida de hueso en los años posteriores a la menopausia. Es un buen momento para empezar a cuidarlo; puedes ver también salud de la mujer y menopausia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué debo traer a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tu última densitometría, las analíticas recientes y la lista de la medicación que tomas."
          }
        }
      ]
    }
