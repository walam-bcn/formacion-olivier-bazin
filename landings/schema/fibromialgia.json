    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/fibromialgia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Se puede mejorar la fibromialgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, es posible reducir el dolor y la fatiga y recuperar actividad. Trabajamos con objetivos realistas y un plan que se ajusta a cómo respondes."
          }
        },
        {
          "@type": "Question",
          "name": "¿El ejercicio no empeora el dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si se dosifica bien, no. Empezamos en un nivel cómodo y aumentamos de forma gradual, respetando los días de más dolor."
          }
        },
        {
          "@type": "Question",
          "name": "¿La acupuntura es adecuada si tengo mucha sensibilidad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Adaptamos el número de agujas, la estimulación y la duración de la sesión a tu tolerancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué debo traer a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tus informes y analíticas recientes, la lista de lo que tomas y, si puedes, unas notas sobre cómo varían tu dolor, tu sueño y tu energía a lo largo de la semana."
          }
        }
      ]
    }
