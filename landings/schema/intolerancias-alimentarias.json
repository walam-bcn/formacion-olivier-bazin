    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/intolerancias-alimentarias#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es lo mismo una intolerancia que una alergia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La alergia es una reacción del sistema inmunitario que puede ser grave y requiere valoración por el alergólogo. La intolerancia es una dificultad digestiva que depende de la cantidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Debo dejar el gluten antes de venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Si sospecha que el gluten le sienta mal, pida antes a su médico que descarte la celiaquía; las pruebas solo son fiables si sigue tomándolo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tendré que retirar estos alimentos para siempre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la mayoría de los casos, no. La retirada es temporal y la reintroducción guiada permite saber cuánto toleras."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y si además tengo colon irritable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es frecuente que coincidan. Puede ver también colon irritable y SIBO."
          }
        }
      ]
    }
