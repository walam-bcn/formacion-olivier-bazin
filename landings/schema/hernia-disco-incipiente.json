    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/hernia-disco-incipiente#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Una hernia de disco puede mejorar sin cirugía?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Muchas hernias mejoran con tratamiento conservador, y una parte se reabsorbe con el tiempo. La cirugía se reserva para casos concretos, como un déficit neurológico progresivo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo hacer ejercicio con una protrusión?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, y es una parte central del tratamiento. Lo adaptamos a sus síntomas y lo progresamos poco a poco."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tratan también la hernia cervical?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, con el mismo enfoque por fases. Si el dolor se irradia al brazo con pérdida de fuerza que avanza, consulte antes con su médico de forma preferente."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre protrusión y hernia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la protrusión el disco se abomba sin que se rompa el anillo externo. En la hernia, parte del núcleo sale a través del anillo. Ambas pueden no dar síntomas y se valoran siempre junto con la exploración."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito una resonancia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No siempre. Si ya la tiene, tráigala a la primera visita. Se indica cuando hay signos de alarma, déficit neurológico o el dolor no mejora tras varias semanas."
          }
        }
      ]
    }
