    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/academia-vida-saludable-barcelona/formaci%C3%B3n-mindfulness#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Necesito experiencia previa en meditación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El programa está diseñado para personas sin experiencia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo hay que practicar en casa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre 30 y 45 minutos al día, con audios guiados. Es una parte esencial del programa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es lo mismo que una clase de relajación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La relajación puede aparecer, pero no es el objetivo. El MBSR entrena la atención y la forma de relacionarte con la experiencia, incluida la incómoda."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay ediciones online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El curso puede ser online o presencial, aunque habitualmente se imparte online."
          }
        }
      ]
