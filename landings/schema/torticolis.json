    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/torticolis#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto dura una tortícolis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría mejora en pocos días y se resuelve en una o dos semanas. Mantener el movimiento y aplicar calor local ayudan a acortar ese tiempo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es mejor el frío o el calor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la tortícolis suele aliviar más el calor local, porque ayuda a relajar la musculatura. Puede aplicarlo unos 15–20 minutos, varias veces al día."
          }
        },
        {
          "@type": "Question",
          "name": "¿Debo inmovilizar el cuello?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No es recomendable. Mover el cuello con suavidad, dentro de lo que el dolor permita, favorece una recuperación más rápida."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué se repite?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los episodios repetidos suelen relacionarse con posturas mantenidas, falta de movilidad dorsal, mal descanso o estrés. Trabajar esos factores ayuda a espaciarlos."
          }
        }
      ]
    }
