      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo se considera que tengo insomnio crónico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cuando te cuesta dormirte o mantener el sueño al menos tres noches por semana durante tres meses, y eso afecta a tu día."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tengo que dejar las pastillas para dormir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No sin hablarlo con tu médico. Cualquier cambio en la medicación debe hacerse con su supervisión."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo debo ir a una unidad del sueño?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si roncas fuerte con pausas en la respiración, tienes mucha somnolencia durante el día o sientes necesidad de mover las piernas por la noche, consulta con tu médico o con una unidad del sueño."
          }
        }
      ]
