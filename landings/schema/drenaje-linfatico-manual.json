      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es lo mismo que la presoterapia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La presoterapia aplica compresión con un aparato neumático; el drenaje linfático manual es una técnica realizada con las manos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis a pacientes con cáncer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, pero siempre con la autorización de su médico y en coordinación con su equipo asistencial."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones necesito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende del motivo. Si tienes linfedema diagnosticado, el número de sesiones se ajusta a lo que indique tu médico especialista."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sesión de 1 hora cuesta 70 € y el bono de 10 sesiones más 1 de regalo, 700 €."
          }
        }
      ]
