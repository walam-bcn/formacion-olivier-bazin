      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Tratáis la hernia de disco?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Acompañamos el dolor asociado a una hernia de disco incipiente o a una protrusión con terapia manual, ejercicio adaptado y educación en dolor. Si hay pérdida de fuerza o de sensibilidad, primero debe valorarte tu médico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo venir con una lumbalgia aguda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En la fase aguda buscamos aliviar el dolor y ayudarte a mantenerte activo dentro de lo que toleras, que es lo que más favorece la recuperación."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito una resonancia antes de venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No es imprescindible. Si ya tienes pruebas, tráelas a la primera visita y las revisamos junto con tu historia clínica."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones necesitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de cada caso. En la primera visita valoramos tu situación y te proponemos un plan con objetivos claros."
          }
        }
      ]
