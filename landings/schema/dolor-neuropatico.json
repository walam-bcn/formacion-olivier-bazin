      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué disciplinas intervienen en el abordaje del dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La osteopatía y la acupuntura, integradas en un plan individual. Cuando se requiere un programa de fisioterapia, realizamos la derivación a un fisioterapeuta colegiado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sustituye a mi tratamiento médico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El acompañamiento es complementario y no modifica la medicación prescrita."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis la ciática?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, como complemento del seguimiento médico, con movilidad, ejercicio adaptado y técnicas manuales cuando están indicadas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y el síndrome de dolor regional complejo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solo como acompañamiento complementario y siempre en paralelo al seguimiento por la unidad del dolor."
          }
        }
      ]
