    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/intolerancia-gluten#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Puedo dejar el gluten antes de hacerme las pruebas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es mejor no hacerlo. La serología y la biopsia de celiaquía necesitan que sigas comiendo gluten para ser fiables. Primero las pruebas, después los cambios."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tendré que eliminar el gluten para siempre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No necesariamente. Muchas personas toleran cierta cantidad. La reintroducción guiada sirve precisamente para encontrar su margen."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y si no es el gluten, sino otros componentes del trigo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A veces los síntomas se deben a los fructanos del trigo, un tipo de FODMAP. Lo valoramos junto a otras intolerancias alimentarias."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué relación tiene con el colon irritable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Comparten síntomas y a menudo coinciden. Si es su caso, el abordaje del colon irritable se integra en el mismo plan."
          }
        }
      ]
