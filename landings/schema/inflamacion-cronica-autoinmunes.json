      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo tarda en notarse la mejoría?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de cada persona, pero los cambios en la alimentación, el sueño y el estrés suelen notarse en pocas semanas. Revisamos el plan con usted en cada visita."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es una alimentación antiinflamatoria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una alimentación basada en verduras, frutas, legumbres, pescado, aceite de oliva y frutos secos, con pocos ultraprocesados. La adaptamos a su situación y a sus digestiones."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué relación hay entre el intestino y la inflamación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La microbiota intestinal participa en la regulación del sistema inmunitario. Por eso cuidar la salud digestiva forma parte del abordaje."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo venir durante un brote?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En las fases de brote adaptamos el plan y priorizamos el descanso, el manejo del dolor y las medidas suaves."
          }
        }
      ]
