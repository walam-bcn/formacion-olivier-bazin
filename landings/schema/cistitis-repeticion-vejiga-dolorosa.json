    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/cistitis-repeticion-vejiga-dolorosa#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Sustituye al tratamiento antibiótico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Las infecciones urinarias deben tratarse según indique su médico. Trabajamos en coordinación con su médico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis a hombres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Nuestro abordaje de la salud pélvica se dirige a mujeres."
          }
        },
        {
          "@type": "Question",
          "name": "Los cultivos salen negativos pero sigo con molestias, ¿qué puede ser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puede tratarse de una cistalgia, un dolor de vejiga sin infección, que se relaciona con la sensibilidad de la región del trígono y con tensiones mecánicas del entorno de la vejiga; su médico debe descartar antes otras causas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué empeoran mis molestias antes de la regla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Porque la región del trígono depende de las hormonas y es más sensible alrededor de la ovulación y antes de la menstruación, cuando además la pelvis está más congestionada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué tengo molestias de vejiga después de las relaciones o de hacer deporte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cuando los análisis no muestran infección, puede tratarse de una cistalgia: una irritación mecánica de la base de la vejiga, el trígono, que se desencadena con más facilidad tras las relaciones sexuales o actividades que sacuden la pelvis, como correr, saltar o montar a caballo. Suele responder especialmente bien al tratamiento osteopático."
          }
        }
      ]
    }
