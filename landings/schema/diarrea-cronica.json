    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/diarrea-cronica#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo se considera crónica una diarrea?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cuando las deposiciones blandas o líquidas se mantienen más de cuatro semanas. Es importante que su médico descarte antes una causa orgánica."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puede ser una intolerancia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A veces sí. La lactosa, la fructosa o algunos azúcares fermentables pueden provocar diarrea. Le ayudamos a identificarlos sin hacer dietas más restrictivas de lo necesario."
          }
        },
        {
          "@type": "Question",
          "name": "¿El estrés puede darme diarrea?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El estrés acelera el tránsito intestinal y aumenta la sensibilidad del intestino. Aprender a regular esa respuesta suele reducir la urgencia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto se tarda en notar mejoría?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de cada caso. Muchas personas notan cambios en pocas semanas al ajustar la alimentación y el manejo del estrés. En la primera visita le proponemos un plan con objetivos claros."
          }
        }
      ]
