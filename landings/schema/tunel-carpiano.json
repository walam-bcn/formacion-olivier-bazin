    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/tunel-carpiano#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo hay que operar el túnel carpiano?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La cirugía se valora sobre todo cuando hay pérdida de fuerza, atrofia del músculo de la base del pulgar o una afectación importante del nervio en el electromiograma, o si el tratamiento conservador no ha sido suficiente."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sirve la férula nocturna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Mantener la muñeca en posición neutra durante la noche reduce la presión sobre el nervio y suele aliviar el hormigueo nocturno."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puede tener relación con el cuello?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El nervio mediano se origina en las raíces cervicales, y la tensión en el cuello o el hombro puede sumar síntomas. Por eso se valora todo su recorrido. Si también tiene dolor cervical, consulte cervicalgia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es frecuente en el embarazo o la menopausia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Los cambios hormonales y la retención de líquidos lo favorecen. En el embarazo suele mejorar en las semanas posteriores al parto."
          }
        }
      ]
    }
