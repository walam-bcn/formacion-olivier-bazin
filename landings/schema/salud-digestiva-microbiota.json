    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/salud-digestiva-microbiota#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Todo el mundo necesita un estudio de microbiota?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Lo proponemos cuando los síntomas persisten, cuando hay antecedentes como tandas de antibióticos o gastroenteritis, o cuando el resultado puede orientar mejor el plan."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se hace el estudio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recoge una pequeña muestra de heces en casa con un kit y la envía a un laboratorio especializado. Cuando llegan los resultados, los revisamos juntos en consulta."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hacéis con los resultados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los interpretamos junto con sus síntomas y su historia, y los traducimos en un plan por fases de alimentación, descanso y regulación del estrés."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo tarda en notarse la mejoría?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muchas personas notan cambios en la digestión en pocas semanas. La microbiota se reequilibra de forma progresiva, por eso trabajamos por fases y revisamos el plan en cada visita."
          }
        }
      ]
    }
