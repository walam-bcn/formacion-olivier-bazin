      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué hago si tengo una tortícolis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mantén el cuello en movimiento suave dentro de lo que toleras y aplica calor local. Si en pocos días no mejora, una valoración ayuda a recuperar la movilidad antes."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis el latigazo cervical tras un accidente?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, una vez descartadas lesiones por tu médico, como complemento del seguimiento médico, con terapia manual suave y ejercicio progresivo."
          }
        },
        {
          "@type": "Question",
          "name": "¿El dolor de cuello puede dar dolor de cabeza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La tensión cervical puede irradiarse a la nuca y la cabeza. Si los dolores de cabeza son frecuentes, consulta también nuestra página de cefaleas y migraña."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones necesitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de cada caso. En la primera visita valoramos tu situación y te proponemos un plan con objetivos claros."
          }
        }
      ]
