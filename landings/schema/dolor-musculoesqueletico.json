    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/dolor-musculoesqueletico#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo debo consultar por un dolor muscular?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si el dolor dura más de unas semanas, se repite o te impide hacer tu actividad habitual."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis lesiones deportivas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: sobrecargas, contracturas, roturas fibrilares y esguinces, con una vuelta progresiva a la actividad."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué se diferencia del dolor articular y miofascial?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El dolor musculoesquelético se centra en el músculo y las lesiones agudas o por sobrecarga; el dolor articular y miofascial incluye la artrosis, las tendinopatías, la fibromialgia y los síndromes miofasciales."
          }
        }
      ]
