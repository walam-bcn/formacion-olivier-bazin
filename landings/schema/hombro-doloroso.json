    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/hombro-doloroso#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto dura un hombro congelado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La capsulitis adhesiva evoluciona por fases y puede durar de uno a tres años. Un plan adaptado a cada fase ayuda a controlar el dolor y a recuperar la movilidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Debo dejar de mover el hombro si me duele?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No es aconsejable inmovilizarlo. Se busca el movimiento que el hombro tolera y se amplía de forma progresiva."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito una ecografía o una resonancia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No siempre. Si ya dispone de pruebas, tráigalas a la primera visita. Si la exploración sugiere una rotura importante, le recomendaremos completar el estudio con una prueba de imagen."
          }
        },
        {
          "@type": "Question",
          "name": "¿El dolor de hombro puede venir del cuello?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, en algunos casos. Por eso se explora también la columna cervical y la dorsal."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué relación tiene con la diabetes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las personas con diabetes tienen más riesgo de capsulitis adhesiva. Un buen control metabólico forma parte del abordaje."
          }
        }
      ]
    }
