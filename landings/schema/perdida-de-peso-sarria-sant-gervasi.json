      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto peso voy a perder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No podemos prometerle una cifra: depende de cada persona. Buscamos una pérdida progresiva que pueda mantener en el tiempo."
          }
        },
        {
          "@type": "Question",
          "name": "¿La acupuntura sirve para adelgazar por sí sola?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No la planteamos así. En WA LAM la acupuntura acompaña a los cambios alimentarios, que son la base del programa. La evidencia sobre la acupuntura aislada para perder peso es limitada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tendré que hacer una dieta estricta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Trabajamos con cambios progresivos y adaptados a usted, sin eliminar grupos de alimentos sin una indicación clara."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo es el seguimiento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cada semana controlamos el peso y ajustamos las pautas nutricionales. Las sesiones de acupuntura son dos por semana, y la duración total depende de sus objetivos."
          }
        }
      ]
