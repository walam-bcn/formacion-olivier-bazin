    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/reiki#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué se siente durante una sesión de reiki?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría de las personas describe una relajación profunda, una sensación de calor o de pesadez agradable y, a menudo, somnolencia. Cada persona lo vive de una forma distinta."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tengo que desvestirme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El reiki se recibe vestido, con ropa cómoda. Solo se le pedirá que se quite los zapatos."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué se diferencia de un masaje?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el reiki no se presiona ni se manipulan los músculos: las manos se apoyan con suavidad o se mantienen cerca del cuerpo. Por eso es adecuado cuando el masaje no es posible o resulta molesto."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo recibir reiki si estoy en tratamiento oncológico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, con la autorización de su oncólogo. Es una técnica muy suave que ofrecen programas de oncología integrativa de distintos hospitales para aliviar la ansiedad y el malestar durante el tratamiento."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones necesitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muchas personas notan una relajación clara desde la primera sesión. Para el estrés, la ansiedad o el insomnio suele recomendarse una sesión semanal durante algunas semanas. Le orientamos según su caso."
          }
        }
      ]
    }
