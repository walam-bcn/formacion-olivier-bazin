    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/estrenimiento#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántas veces hay que ir al baño para que sea normal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre tres veces al día y tres veces por semana se considera normal. Más que la frecuencia, importa que evacuar no le cueste y que se quede bien."
          }
        },
        {
          "@type": "Question",
          "name": "¿Basta con comer más fibra?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La fibra ayuda, pero hay que aumentarla poco a poco y acompañarla de agua y movimiento. Si le hincha, ajustamos el tipo de fibra."
          }
        },
        {
          "@type": "Question",
          "name": "¿El masaje abdominal sirve de verdad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí: estimula el tránsito y relaja el abdomen. Le enseñamos a hacerlo en casa para que lo incorpore a su rutina."
          }
        },
        {
          "@type": "Question",
          "name": "¿Influye la postura en el inodoro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mucho. Con los pies elevados en un taburete y el tronco ligeramente inclinado, el recto se alinea y el suelo pélvico se relaja, de modo que evacuar cuesta menos."
          }
        }
      ]
