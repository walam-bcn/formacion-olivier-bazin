    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/dolor-ovarico-quistes-ovario#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué me duele la ingle o el muslo si el problema es el ovario?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los nervios del ovario conectan con los que llevan la sensibilidad de la pared abdominal baja, la ingle y el muslo, y el ovario puede estar cerca del nervio obturador. Por eso su dolor puede notarse lejos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué el dolor de ovarios me da náuseas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El ovario y la trompa reciben fibras del nervio vago, que también regula la digestión."
          }
        },
        {
          "@type": "Question",
          "name": "¿La osteopatía trata los quistes de ovario?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Un quiste lo debe diagnosticar y seguir su ginecólogo. La osteopatía se ocupa de la movilidad de los tejidos que rodean el ovario y del dolor de origen mecánico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué me duele más el ovario izquierdo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se relaciona con su drenaje venoso hacia el riñón izquierdo y con la tendencia del cuello del útero a fijarse hacia atrás y a la izquierda, lo que puede congestionar ese ovario."
          }
        },
        {
          "@type": "Question",
          "name": "¿Una ciática puede venir del ovario?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En mujeres que han tenido hijos o de más edad, el ovario puede irritar los nervios de la nalga y del piriforme y causar una ciática alta que empeora antes de la regla. Antes, su médico debe descartar otras causas."
          }
        }
      ]
    }
