      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones necesitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de tu caso. En general revisamos la evolución tras dos o tres sesiones y decidimos juntos si tiene sentido continuar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Duele?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría de técnicas son suaves. Algunas pueden producir una molestia leve o sensación de cansancio durante uno o dos días."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre osteopatía y fisioterapia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ambas son complementarias. La osteopatía se centra en la valoración y el tratamiento manual global; la fisioterapia pone más peso en el ejercicio, la recuperación funcional y la readaptación."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito prescripción médica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No es necesaria. Si durante la valoración detectamos algo que requiere estudio médico, te lo diremos."
          }
        }
      ]
