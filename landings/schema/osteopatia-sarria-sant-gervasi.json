    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/osteopatia-sarria-sant-gervasi#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones necesitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de su caso. En general revisamos la evolución tras dos o tres sesiones y decidimos juntos si tiene sentido continuar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Duele?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría de técnicas son suaves. Algunas pueden producir una molestia leve o sensación de cansancio durante uno o dos días."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre osteopatía y fisioterapia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ambas se combinan bien. La osteopatía se centra en la valoración y el tratamiento manual global; la fisioterapia pone más peso en el ejercicio, la recuperación funcional y la readaptación."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo venir si estoy embarazada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Atendemos a mujeres embarazadas, adaptando el tratamiento a cada etapa. Más información en osteopatía en el embarazo y el posparto."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito prescripción médica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No es necesaria. Si durante la valoración detectamos algo que requiere estudio médico, se lo diremos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se utilizan aparatos en la sesión de osteopatía?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La osteopatía es una terapia exclusivamente manual: las manos sirven para valorar y para tratar, con intensidades que van desde movilizaciones articulares hasta contactos fasciales muy suaves."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay una edad mínima o máxima para recibir osteopatía?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Se puede aplicar desde las primeras semanas de vida hasta edades avanzadas, adaptando siempre la intensidad y la duración de la sesión a cada persona."
          }
        }
      ]
    }
