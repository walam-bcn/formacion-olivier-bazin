    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/fatiga-cronica-agotamiento#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Necesito un diagnóstico de fatiga crónica para venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Atendemos el agotamiento persistente tenga o no un diagnóstico. Si no se ha hecho analíticas recientes, le recomendaremos que lo comente con su médico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y si además tengo el ánimo bajo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es frecuente y lo tenemos en cuenta en el plan. Si hay signos de depresión moderada o grave, le recomendaremos la valoración de un profesional de salud mental."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hacer ejercicio no me cansará más?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Por eso lo dosificamos. Empezamos con movimiento suave y breve y solo aumentamos cuando su energía lo permite."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo se tarda en notar mejoría?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de cada persona y de cuánto tiempo lleva agotada o agotado. En la primera visita le proponemos un plan y lo revisamos con usted."
          }
        }
      ]
