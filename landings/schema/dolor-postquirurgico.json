    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/dolor-postquirurgico#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es normal tener dolor meses después de una operación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es más frecuente de lo que se cree: entre el 10 % y el 50 % de las personas mantienen algún grado de dolor tras cirugías habituales. Conviene valorarlo pronto para evitar que se cronifique."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo puedo empezar después de la operación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende del tipo de intervención y de los plazos que le indique su cirujano. En la primera visita valoramos en qué fase de la recuperación se encuentra."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué me molesta la cicatriz al roce?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es frecuente cuando se han lesionado pequeños nervios de la piel durante la cirugía. Esta hipersensibilidad (alodinia) suele mejorar con un trabajo progresivo sobre la cicatriz y la regulación del dolor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atienden el dolor tras una cirugía oncológica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, siempre con la autorización de su médico. Encontrará más información en dolor oncológico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué debo traer a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El informe quirúrgico y las pruebas o informes médicos recientes que tenga. Nos ayudan a conocer bien su caso."
          }
        }
      ]
