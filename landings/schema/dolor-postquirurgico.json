      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué disciplinas intervienen en el abordaje del dolor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La osteopatía y la acupuntura, integradas en un plan individual. Cuando se requiere un programa de fisioterapia, realizamos la derivación a un fisioterapeuta colegiado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es normal tener dolor meses después de operarme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es más frecuente de lo que se cree: entre un 10 % y un 50 % de las personas mantienen dolor tras cirugías habituales. Conviene valorarlo para evitar que se cronifique."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo puedo empezar después de la operación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la intervención y de lo que indique tu cirujano."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y después de una cirugía oncológica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, siempre con autorización médica firmada. Más información en dolor oncológico."
          }
        }
      ]
