    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/osteopatia-bebes-ninos#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Desde qué edad se puede tratar a un bebé?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desde las primeras semanas de vida, una vez que el pediatra ha realizado las revisiones habituales. Las técnicas se adaptan a cada edad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es segura la osteopatía en bebés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se utilizan técnicas muy suaves, sin manipulaciones bruscas, y se respeta en todo momento el estado y el ritmo del bebé. La valoración inicial permite identificar los signos que requieren la atención del pediatra."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puede ayudar en la plagiocefalia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la plagiocefalia postural, mejorar la movilidad del cuello y cambiar las posturas de apoyo es clave. Cuanto antes se aborde, mejor responde el cráneo, que en los primeros meses es muy moldeable."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones suelen ser necesarias?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En los bebés suelen bastar pocas sesiones, espaciadas una o dos semanas. Tras la primera valoración le orientamos según la evolución de su hijo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué debo traer a la primera sesión?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los informes del pediatra y del parto si los tiene, un pañal de recambio y lo necesario para alimentarlo. Es preferible venir con el bebé descansado y sin haber comido justo antes."
          }
        }
      ]
    }
