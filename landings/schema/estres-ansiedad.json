    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/estres-ansiedad#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Esto sustituye a la terapia psicológica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Trabajamos la dimensión corporal y fisiológica del estrés. Si tu situación necesita psicoterapia o tratamiento médico, te lo diremos y nos coordinaremos cuando sea posible."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre la consulta individual y el MBSR?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La consulta individual se adapta a tu situación concreta. El MBSR es un programa grupal estructurado de 8 semanas con fechas e inscripción propias. Muchas personas combinan ambos."
          }
        },
        {
          "@type": "Question",
          "name": "¿La osteopatía ayuda con el estrés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puede ayudar a aliviar la tensión física asociada y a mejorar la percepción corporal, pero no actúa sobre las causas del estrés. Por eso la proponemos como complemento."
          }
        },
        {
          "@type": "Question",
          "name": "Tengo crisis de ansiedad. ¿Puedo venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, pero si las crisis son frecuentes o intensas es importante que también te valore un profesional de salud mental. Escríbenos y lo hablamos."
          }
        }
      ]
    }
