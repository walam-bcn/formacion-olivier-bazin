    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/contracturas-desgarros-musculares#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es mejor el reposo absoluto tras una rotura fibrilar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los primeros días conviene proteger la zona. Después, el músculo se repara mejor con una carga progresiva y bien dosificada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo podré volver a hacer deporte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende del grado de la lesión y de su actividad. La vuelta se decide con criterios de fuerza, movilidad y ausencia de dolor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es mejor aplicar calor o frío?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En una rotura reciente, frío durante los primeros días. En una contractura, el calor local suele aliviar la tensión."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué se repiten mis contracturas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Suelen influir la sobrecarga, las posturas mantenidas, la falta de fuerza, el estrés y el descanso. Por eso se revisan todos estos factores."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y si lo que tengo es una torcedura de tobillo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las lesiones de ligamentos se tratan de forma específica. Puede consultar la página de esguinces."
          }
        }
      ]
