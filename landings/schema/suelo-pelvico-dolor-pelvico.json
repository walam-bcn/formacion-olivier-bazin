    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/suelo-pelvico-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Hacéis tratamiento interno?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Nuestro abordaje es siempre externo. Si necesita un tratamiento intracavitario, le orientamos hacia una fisioterapeuta especializada en suelo pélvico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito un diagnóstico médico antes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es recomendable, sobre todo si el dolor es reciente, intenso o se acompaña de sangrado o fiebre."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis a hombres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No atendemos el dolor pélvico masculino. Le orientaremos hacia un urólogo o una fisioterapeuta especializada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo pido cita para una valoración de suelo pélvico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Escríbanos por WhatsApp, cuéntenos brevemente qué nota y le proponemos día y hora para la primera valoración, de 60 minutos, en Sarrià–Sant Gervasi."
          }
        }
      ]
    }
