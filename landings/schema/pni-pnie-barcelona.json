      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre PNI y PNIE?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Son prácticamente lo mismo. La «E» de PNIE subraya el papel del sistema endocrino (hormonal), que en la práctica ya está incluido en la PNI."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito traer analíticas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si tiene analíticas recientes, tráigalas. Si hace falta alguna prueba, se lo indicaremos y le explicaremos para qué."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es lo mismo que nutrición?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La alimentación es una parte importante, pero la consulta de PNIE también aborda sueño, estrés, movimiento y ritmos circadianos."
          }
        }
