    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/intolerancia-histamina#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué alimentos tienen más histamina?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sobre todo los fermentados y curados: vino, cerveza, quesos curados, embutidos, conservas de pescado, chucrut o salsa de soja. Las sobras guardadas varios días también acumulan histamina."
          }
        },
        {
          "@type": "Question",
          "name": "¿La dieta baja en histamina es para siempre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Es una fase temporal. Después reintroducimos alimentos para que su dieta sea lo más amplia posible dentro de su tolerancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tiene relación con la migraña?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En algunas personas la histamina es un desencadenante del dolor de cabeza. Si es su caso, puede consultar también cefaleas y migraña."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo tomar suplementos de DAO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pueden ser útiles en algunas personas como apoyo a la dieta. Lo valoramos con usted según su caso."
          }
        }
      ]
    }
