    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/dolor-articular-miofascial#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre artrosis y artritis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La artrosis es un proceso degenerativo del cartílago, con un dolor que empeora con el uso. La artritis es una inflamación de la articulación, con hinchazón, calor y rigidez matutina prolongada, y requiere una valoración médica para conocer su causa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo hacer ejercicio si tengo artrosis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El ejercicio adaptado es una de las medidas con más respaldo científico en la artrosis. Lo ajustamos a su articulación, a su nivel físico y a la fase de su dolor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es un punto gatillo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es una zona hipersensible dentro de un músculo, palpable como un nódulo o una banda tensa. Al presionarla reproduce el dolor de la persona, a veces a distancia del propio punto."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es lo mismo el dolor miofascial que la fibromialgia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El dolor miofascial es regional y se relaciona con puntos gatillo concretos; la fibromialgia cursa con dolor generalizado, fatiga y sueño no reparador."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito una radiografía antes de la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No es imprescindible. Si dispone de pruebas o informes recientes, tráigalos; si hicieran falta otras pruebas, se lo indicaremos."
          }
        }
      ]
    }
