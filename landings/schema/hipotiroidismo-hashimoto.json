    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/hipotiroidismo-hashimoto#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué debo traer a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sus analíticas recientes de tiroides (TSH, T4 libre y anticuerpos), y si las tiene, de hierro, vitamina D y vitamina B12. Con ellas y su historia preparamos un plan a su medida."
          }
        },
        {
          "@type": "Question",
          "name": "¿Debo tomar suplementos de selenio o yodo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No por su cuenta. El exceso de yodo puede ser perjudicial en la tiroiditis. Cualquier suplemento debe valorarlo su médico a partir de sus análisis."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay que seguir una dieta sin gluten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solo si tiene celiaquía o una sensibilidad confirmada. En el resto de casos priorizamos una alimentación variada, rica en alimentos frescos y adaptada a sus digestiones."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué sigo con cansancio si mis análisis están bien?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El cansancio puede tener varios factores: el sueño, el estrés, niveles bajos de hierro o de vitamina D, o las digestiones. Los revisamos con usted en la primera visita."
          }
        }
      ]
