    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/alergias-asma-infecciones#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Puedo dejar mi medicación para el asma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Nunca debes dejar ni reducir los inhaladores ni otros tratamientos sin indicación de tu médico. Trabajamos a la vez la respiración, el sueño y la microbiota para que te encuentres mejor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué tiene que ver la microbiota con las alergias?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La microbiota intestinal participa en la educación del sistema inmunitario. Cuidarla con la alimentación forma parte de un abordaje global."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis a personas con infecciones de orina de repetición?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En mujeres, puedes ver también cistitis de repetición."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo es mejor empezar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cualquier momento es bueno, pero en las alergias estacionales conviene empezar unas semanas antes de la temporada de polen."
          }
        }
      ]
