      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo tarda en notarse la mejoría?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de cada caso. Los cambios de hábitos y de alimentación se valoran a lo largo de unos meses, observando si los episodios se espacian y son más leves."
          }
        },
        {
          "@type": "Question",
          "name": "¿La exploración es interna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Trabajamos siempre con un abordaje externo y atendemos únicamente a mujeres."
          }
        },
        {
          "@type": "Question",
          "name": "¿Influye la alimentación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La alimentación influye en la microbiota y en el control de la glucosa. Revisamos tus hábitos para reducir el exceso de azúcares y ultraprocesados y favorecer una microbiota diversa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hábitos pueden ayudar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Evitar las duchas vaginales y los productos perfumados, usar ropa interior transpirable y cambiarse pronto la ropa húmeda después de nadar o hacer deporte."
          }
        }
      ]
    }
