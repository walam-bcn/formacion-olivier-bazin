    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/cortisol-estres-cronico#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Necesito un análisis de cortisol?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No siempre. El estrés crónico se reconoce sobre todo por cómo se siente y cómo duerme. Si su médico sospecha una enfermedad endocrina, es él quien indica las pruebas."
          }
        },
        {
          "@type": "Question",
          "name": "¿El estrés puede hacerme engordar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puede favorecer la grasa abdominal, el picoteo y el mal descanso. Si es su caso, trabajamos el estrés junto con la pérdida de peso."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué se diferencia del agotamiento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El estrés sostenido puede acabar en un agotamiento físico y emocional. Cuanto antes se aborda, más fácil es recuperar la energía."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y si además tengo ansiedad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es frecuente que vayan juntos. Puede leer más sobre el abordaje del estrés y la ansiedad."
          }
        }
      ]
