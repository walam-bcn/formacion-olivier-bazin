    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/congestion-pelvica-sindrome-premenstrual#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿El síndrome premenstrual es «normal»?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las pequeñas molestias antes de la regla son muy frecuentes: según un estudio clásico, el 95 % de las mujeres las tiene en algún momento de su vida. Cuando se repiten cada ciclo y alteran su vida diaria, merece la pena valorarlas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo es mejor pedir la cita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Justo después de la regla y antes del día 14, cuando la pelvis suele estar menos congestionada y los tejidos responden mejor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones hacen falta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se suelen proponer dos o tres sesiones, separadas por la duración de un ciclo. No es un problema que se resuelva en una sola visita."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué me valoran el hígado y el riñón si me duele la pelvis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Porque el drenaje venoso de la pelvis pasa por ellos: la vena ovárica izquierda desemboca en la vena renal izquierda y la congestión del hígado frena el retorno por la vena cava. Además, el hígado degrada las hormonas sexuales."
          }
        },
        {
          "@type": "Question",
          "name": "¿La valoración es interna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. En WA LAM el abordaje es siempre externo, sobre el abdomen, la pelvis, la espalda y el tórax."
          }
        }
      ]
    }
