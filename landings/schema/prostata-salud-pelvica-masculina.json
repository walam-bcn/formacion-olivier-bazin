    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/prostata-salud-pelvica-masculina#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿La prostatitis es siempre una infección?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La forma más frecuente es el síndrome de dolor pélvico crónico, en el que no se encuentra ninguna bacteria y el suelo pélvico y el sistema nervioso tienen un papel importante."
          }
        },
        {
          "@type": "Question",
          "name": "¿El hombre también tiene suelo pélvico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Sostiene la vejiga y el recto, ayuda a controlar la orina y participa en la erección y la eyaculación."
          }
        },
        {
          "@type": "Question",
          "name": "¿La próstata puede dar dolor de espalda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Comparte inervación con la zona lumbar baja y el sacro, y su irritación puede sentirse como dolor lumbar referido."
          }
        },
        {
          "@type": "Question",
          "name": "¿El tratamiento es interno?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. En WA LAM el abordaje es siempre manual y externo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo venir después de una operación de próstata?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, cuando su urólogo lo autorice. El trabajo del suelo pélvico y de las cicatrices ayuda a recuperar el control de la orina."
          }
        }
      ]
    }
