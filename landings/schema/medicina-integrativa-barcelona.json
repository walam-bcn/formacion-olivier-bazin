    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es la medicina integrativa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es una medicina basada en la evidencia que mira a la persona entera, no solo al síntoma. Combina el conocimiento científico actual con las terapias complementarias que cuentan con respaldo científico, como complemento del seguimiento de tu médico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es lo mismo que la medicina alternativa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La medicina alternativa se plantea como sustituta de la medicina convencional. La medicina integrativa la complementa y solo utiliza las terapias que disponen de respaldo científico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La primera visita cuesta 90 €."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto dura la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sesenta minutos. Si tienes analíticas o pruebas recientes, tráelas: las utilizamos para no repetir pruebas sin motivo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde está el centro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la calle Bisbe Sivilla, 44, 08022 Barcelona, en el distrito de Sarrià–Sant Gervasi."
          }
        }
      ]
