      "@type": "FAQPage",
      "@id": "https://www.walambcn.com#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es lo mismo que la medicina alternativa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La medicina alternativa se plantea como sustituta de la medicina convencional. La medicina integrativa la complementa y solo utiliza las terapias que disponen de respaldo científico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto dura y cuánto cuesta la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dura sesenta minutos y cuesta 90 €."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito un diagnóstico para venir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Puede venir con un diagnóstico o simplemente porque nota que algo no va bien. En la primera visita revisamos su historia y las pruebas que ya tenga y, si hace falta alguna más, se lo indicamos."
          }
        }
      ]
