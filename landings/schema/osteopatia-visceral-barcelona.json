    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/osteopatia-visceral-barcelona#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Duele la osteopatía visceral?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No suele doler. Las técnicas son suaves y se adaptan a la sensibilidad de cada zona. Algunas áreas pueden notarse más sensibles durante la sesión."
          }
        },
        {
          "@type": "Question",
          "name": "¿Quién fue Jean-Pierre Barral?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es un osteópata y fisioterapeuta francés, creador de la manipulación visceral. Desarrolló el método a partir de su trabajo en un hospital de Grenoble y de sus estudios de anatomía; hoy se enseña en todo el mundo a través del Barral Institute."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puede ayudar con el colon irritable o el estreñimiento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los estudios en el síndrome del intestino irritable muestran mejoras del dolor y la distensión abdominal. Lo integramos con la alimentación y la salud digestiva, según su caso."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones necesitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende del motivo de consulta y de su evolución. Tras la primera sesión le orientamos sobre la frecuencia; a menudo se espacian una o dos semanas para observar la respuesta del cuerpo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay con la manipulación neural?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La osteopatía visceral se centra en los órganos, sus fascias y sus ligamentos; la manipulación neural y neurovisceral, en los nervios y las meninges. Ambas forman parte del método Barral y suelen combinarse."
          }
        }
      ]
    }
