    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/trompas-salpingitis#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Si ya me trataron la salpingitis, ¿puede quedar alguna secuela?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según el libro, toda infección, incluso tratada a tiempo, deja microadherencias que pueden restar movilidad a la trompa. Son esas secuelas mecánicas las que se valoran en osteopatía."
          }
        },
        {
          "@type": "Question",
          "name": "¿La osteopatía puede desobstruir una trompa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No se puede prometer. Los autores creen que liberar el peritoneo y relajar los espasmos favorece la función de la trompa, pero una obstrucción la debe valorar su ginecólogo o su clínica de fertilidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo es mejor hacer las sesiones si busco un embarazo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los autores proponen la semana siguiente a la regla y tres sesiones separadas por un mes."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué tiene que ver mi apendicitis con mis trompas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El apéndice, la trompa y el ovario derechos están muy próximos; las adherencias tras una apendicectomía pueden modificar las tensiones del peritoneo alrededor de la trompa derecha."
          }
        },
        {
          "@type": "Question",
          "name": "¿Me harán una exploración interna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. En WA LAM el abordaje es siempre externo."
          }
        }
      ]
    }
