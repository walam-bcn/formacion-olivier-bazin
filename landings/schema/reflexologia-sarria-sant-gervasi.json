    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/reflexologia-podal#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Duele la reflexología podal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No debería. Algunas zonas pueden notarse más sensibles, pero la presión se ajusta en todo momento a su tolerancia. La mayoría de las personas la viven como una experiencia muy agradable."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay con un masaje de pies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La reflexología sigue un recorrido sistemático por todas las zonas de ambos pies, con presión mantenida y puntual, mientras que el masaje de pies trabaja sobre todo la musculatura con maniobras de deslizamiento y amasamiento."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo recibir reflexología si estoy en tratamiento oncológico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, con la autorización de su oncólogo. Es una de las técnicas que recomiendan las guías de oncología integrativa para aliviar el dolor durante el tratamiento, y se adapta a su estado en cada sesión."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas sesiones necesitaré?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muchas personas notan una relajación clara desde la primera sesión. Para el estrés o el insomnio suele recomendarse una sesión semanal durante cuatro a seis semanas. Le orientamos según su caso."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta y tienen tarjetas regalo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sesión de 60 minutos cuesta 70 €. Dispone de un bono de 10 sesiones + 1 de regalo y de tarjetas regalo: escríbanos por WhatsApp."
          }
        }
      ]
    }
