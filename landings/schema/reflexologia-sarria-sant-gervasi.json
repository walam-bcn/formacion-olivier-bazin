    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/reflexologia-podal#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿La reflexología sustituye a un tratamiento médico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La ofrecemos como una técnica de bienestar y relajación, complementaria a su tratamiento."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo recibir reflexología si estoy en tratamiento oncológico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, siempre con la autorización de su médico. La guía SIO–ASCO contempla la reflexología como apoyo para el dolor durante el tratamiento del cáncer. En WA LAM no tratamos a ningún paciente oncológico sin autorización médica, ni con reflexología, ni con drenaje, ni con masaje."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay alguna contraindicación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Avísenos si tiene heridas, infecciones o problemas circulatorios en los pies, o si está embarazada."
          }
        }
      ]
