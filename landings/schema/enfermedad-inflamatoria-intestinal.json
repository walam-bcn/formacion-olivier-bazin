    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/enfermedad-inflamatoria-intestinal#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué debo traer a la primera visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sus informes recientes, las analíticas y la lista de lo que toma. Con eso y su historia diseñamos un plan centrado en su energía, su alimentación y su calidad de vida."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hay una dieta para el Crohn o la colitis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No hay una dieta única. Ajustamos la alimentación a su fase, sus síntomas y sus tolerancias para comer con más seguridad y variedad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Podéis ayudarme con la fatiga?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Revisamos el sueño, la actividad, el estrés y la alimentación, y proponemos movimiento suave adaptado a su energía."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo venir durante un brote?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En un brote, la prioridad es su equipo de digestivo. Podemos acompañarle con pautas suaves y retomar el plan cuando esté más estable."
          }
        }
      ]
