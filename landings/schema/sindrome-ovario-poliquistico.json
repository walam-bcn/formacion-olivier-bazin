    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/sindrome-ovario-poliquistico#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Tengo que perder peso para mejorar el SOP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No siempre. El ejercicio y la alimentación mejoran la sensibilidad a la insulina también sin pérdida de peso. Si hay sobrepeso, una reducción moderada ya puede ayudar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué tipo de alimentación recomendáis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una alimentación basada en alimentos frescos, con proteína y fibra en cada comida y pocos azúcares y ultraprocesados. La adaptamos a sus gustos y a su ritmo de vida."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo tarda en notarse la mejoría?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La energía y las digestiones suelen mejorar en pocas semanas. Los cambios en el ciclo y en la piel necesitan algo más de tiempo, normalmente unos meses de constancia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Y si busco un embarazo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "También le acompañamos en esa etapa. Puede conocer nuestro acompañamiento a la fertilidad."
          }
        }
      ]
