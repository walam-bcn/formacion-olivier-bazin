    {
      "@type": "FAQPage",
      "@id": "https://www.walambcn.com/tratamientos-sarri%C3%A0-sant-gervasi-barcelona/vejiga-hiperactiva-urgencia#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es normal tener ganas de orinar con poca orina?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El primer deseo suele aparecer hacia los 150 ml. Si nota ganas urgentes con mucho menos, la vejiga puede estar hipersensible y conviene valorarlo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Debo beber menos para ir menos al baño?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Es mejor beber a menudo y en pequeñas cantidades, porque mucha agua de golpe aumenta la tensión de la pared de la vejiga."
          }
        },
        {
          "@type": "Question",
          "name": "Si los análisis están bien, ¿por qué tengo síntomas de cistitis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se llaman cistalgias las molestias vesicales sin infección. Suelen deberse a una irritación mecánica de la base de la vejiga y, en la práctica clínica, a menudo responden bien al trabajo manual."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo es mejor hacer las sesiones?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Por lo general, la semana siguiente a la regla, cuando la base de la vejiga está menos sensible."
          }
        },
        {
          "@type": "Question",
          "name": "¿Tiene relación con el estrés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En la vejiga hipersensible lo local y lo central son interdependientes: las tensiones emocionales influyen en ella."
          }
        }
      ]
    }
