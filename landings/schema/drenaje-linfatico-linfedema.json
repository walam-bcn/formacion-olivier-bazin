      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Sustituye al tratamiento de mi médico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. El tratamiento se realiza en coordinación con su médico especialista en linfedema: el especialista se encarga de la valoración, las mediciones y la indicación de la compresión, y WA LAM del drenaje linfático manual."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se puede hacer acupuntura si tengo linfedema?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, como apoyo al bienestar, pero sin pinchar nunca el brazo o la pierna afectados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito autorización médica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Sin la autorización de su médico no tratamos a ningún paciente oncológico, ni con drenaje, ni con reflexología, ni con masaje."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sesión de 1 hora cuesta 70 € y el bono de 10 sesiones más 1 de regalo, 700 €."
          }
        }
      ]
